#!/bin/sh /etc/rc.common
# The Aeolus agent (0040), its key agent (0070), its prober (0059) and its
# radio resource management (0073). Their log: logread -e aeolus

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/aeolus-agent
	procd_set_param respawn 3600 5 0
	# The agent logs to syslog itself; this catches a crash.
	procd_set_param stderr 1
	procd_close_instance

	# The key agent keeps the AP's per-user keys (0070), apart from config.
	procd_open_instance keys
	procd_set_param command /usr/sbin/aeolus-agent keys
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	# The prober probes the tunnels and guards tunnel ports against loops.
	# It needs ucode's socket module; without it, the agent reports that.
	if [ -e /usr/lib/ucode/socket.so ]; then
		procd_open_instance prober
		procd_set_param command /usr/sbin/aeolus-prober
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi

	# Radio resource management finds the AP's radio neighbours (0073). It
	# stays idle until Aeolus turns it on, and needs ucode's nl80211,
	# digest and socket modules.
	if [ -e /usr/lib/ucode/nl80211.so ] && [ -e /usr/lib/ucode/digest.so ] && [ -e /usr/lib/ucode/socket.so ]; then
		procd_open_instance rrm
		procd_set_param command /usr/sbin/aeolus-rrm
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi
}

#!/bin/sh /etc/rc.common
# The Aeolus agent (0040), its key agent (0070), its prober (0059), its
# radio resource management (0073) and its record of clients coming online
# (0118). Their log: logread -e aeolus

START=99
USE_PROCD=1

# The ucode modules the agent cannot start without; the package depends on
# them (0080).
REQUIRED="fs uci ubus uloop uclient math log digest"

start_service() {
	# Installed, the agent is inert until aeolus-setup has said where the
	# manager is (0080).
	[ -n "$(uci -q get aeolus.agent.url)" ] || return 0

	# After a sysupgrade the agent's files are kept (keep.d) but packages
	# are not, and where the image lacks one of the modules the agent needs
	# (uclient, on some), it cannot start to put them back itself. This
	# script is plain shell, so it starts that here; procd retries the agent
	# until the module is back.
	for m in $REQUIRED; do
		[ -e /usr/lib/ucode/$m.so ] && continue
		setsid /usr/libexec/aeolus-packages restore </dev/null >/dev/null 2>&1 &
		break
	done

	procd_open_instance
	procd_set_param command /usr/sbin/aeolus-agent
	procd_set_param respawn 3600 5 0
	# The agent logs to syslog itself; this catches a crash.
	procd_set_param stderr 1
	procd_close_instance

	# The key agent keeps the AP's per-user keys (0070), apart from config.
	procd_open_instance keys
	procd_set_param command /usr/sbin/aeolus-agent keys
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance

	# The prober probes the tunnels and guards tunnel ports against loops.
	# It needs ucode's socket module; without it, the agent reports that.
	if [ -e /usr/lib/ucode/socket.so ]; then
		procd_open_instance prober
		procd_set_param command /usr/sbin/aeolus-prober
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi

	# Radio resource management finds the AP's radio neighbours (0073). It
	# stays idle until Aeolus turns it on, and needs ucode's nl80211,
	# digest and socket modules.
	if [ -e /usr/lib/ucode/nl80211.so ] && [ -e /usr/lib/ucode/digest.so ] && [ -e /usr/lib/ucode/socket.so ]; then
		procd_open_instance rrm
		procd_set_param command /usr/sbin/aeolus-rrm
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi

	# The record of each Wi-Fi client coming online, step by step (0118). It
	# needs ucode's socket module, and logread, which OpenWrt has.
	if [ -e /usr/lib/ucode/socket.so ] && [ -x /sbin/logread ]; then
		procd_open_instance journey
		procd_set_param command /usr/sbin/aeolus-journey
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	fi
}

#!/usr/bin/ucode -S
// aeolus-agent: the Aeolus agent on an OpenWrt AP (0040).
//
// It enrolls, polls for its config, renders it into UCI, has the manager
// check that, applies it with an automatic revert, and reports what it did
// and how it is. procd runs it (/etc/init.d/aeolus) and restarts it.
//
//	aeolus-agent          run
//	aeolus-agent facts    print what it would enroll with
//	aeolus-agent ping     check it can reach the manager

'use strict';

import * as fs from 'fs';
import * as uloop from 'uloop';
import * as uclient from 'uclient';
import * as math from 'math';
import { sha256 } from 'digest';
import { openlog, syslog, LOG_PID, LOG_DAEMON, LOG_INFO, LOG_WARNING, LOG_ERR } from 'log';
import { cursor } from 'uci';
import { connect } from 'ubus';
import { render, clamp, PACKAGES, CLAMP, VLAN_END, iface_name, without_keys } from 'aeolus.render';
import { text, file } from 'aeolus.uciexport';

const AGENT = 'aeolus-agent/1';
const DIR = '/etc/aeolus';
const TOKEN = DIR + '/token';
const CERT = DIR + '/manager.crt';
const RUNNING = DIR + '/version';
const PENDING = DIR + '/pending';
const BACKUP = DIR + '/backup';
const CONFIRM = 90;        // seconds to reach the manager again after an apply
const WIFI_WAIT = 150;     // seconds for the Wi-Fi to come back after an apply, a radar check included
const STATE_EVERY = 300;   // seconds between state reports
const PROBES = '/var/run/aeolus/probes.json';   // what the prober found (0059)
const PROBES_STALE = 60;   // seconds after which the prober's results are too old to report
const PACKAGES_TOOL = '/usr/libexec/aeolus-packages';   // its packages, through the manager (0069)
const PACKAGES_DONE = '/usr/lib/aeolus/packages';      // gone after a sysupgrade, until they are back
const RESTORE_EVERY = 3600;   // seconds between tries to install them again
const TIME = '/var/run/aeolus/time.json';   // ntpd's word on the clock, from its hotplug (0069)
const KEYS_VERSION = DIR + '/keys.version';  // the per-user keys the AP has (0070)
const RRM_KEY = DIR + '/rrm.key';   // the key radio neighbours sign their hellos with (0073)
const RRM = '/var/run/aeolus/rrm.json';   // what radio resource management found (0073)
const KEYS_WAIT = 40;      // seconds the manager may hold a request for keys

let bus = connect();

// The log goes to syslog as "aeolus": what happens at info, a held config at
// warning, and what went wrong at error. logread -e aeolus shows it.
openlog('aeolus', LOG_PID, LOG_DAEMON);

function log(fmt, ...args) {
	syslog(LOG_INFO, fmt, ...args);
}

function note(fmt, ...args) {
	syslog(LOG_WARNING, fmt, ...args);
}

function fail(fmt, ...args) {
	syslog(LOG_ERR, fmt, ...args);
}

function read(path) {
	let v = fs.readfile(path);
	return v == null ? null : trim(v);
}

// store writes a file whole, through a temporary one, so it is never half
// written. mode is set before it takes the file's place.
function store(path, data, mode) {
	let tmp = path + '.new';
	if (fs.writefile(tmp, data) == null)
		return false;
	if (mode != null)
		fs.chmod(tmp, mode);
	return fs.rename(tmp, path);
}

function run(cmd) {
	let p = fs.popen(cmd, 'r');
	if (!p)
		return '';
	let out = p.read('all') ?? '';
	p.close();
	return trim(out);
}

function settings() {
	let a = cursor().get_all('aeolus', 'agent') ?? {};
	return { url: rtrim(a.url ?? '', '/'), uplink: a.uplink, poll: int(a.poll ?? '60') || 60 };
}

// http makes one request to the manager, trusting only its pinned
// certificate (0033).
function http(method, path, body, token, extra, timeout) {
	let base = settings().url;
	if (!base)
		return { status: 0, error: 'no manager URL (aeolus.agent.url)' };
	let res = { status: 0, body: '' };
	let uc;
	uc = uclient.new(base + path, null, {
		header_done: function() {
			res.status = uc.status().status;
		},
		data_read: function() {
			let chunk;
			while (length(chunk = uc.read() ?? ''))
				res.body += chunk;
		},
		data_eof: function() {
			uloop.end();
		},
		error: function(cb, code) {
			res.error = 'connection error ' + code;
			uloop.end();
		},
	});
	if (!uc)
		return { status: 0, error: 'bad manager URL' };
	if (!uc.ssl_init({ ca_files: [CERT], verify: true })) {
		uc.free();
		return { status: 0, error: 'cannot set up TLS' };
	}
	uc.set_timeout(timeout ?? 20000);
	if (!uc.connect()) {
		uc.free();
		return { status: 0, error: 'cannot connect to ' + base };
	}
	let headers = { 'User-Agent': AGENT, ...(extra ?? {}) };
	if (token)
		headers['Authorization'] = 'Bearer ' + token;
	let args = { headers: headers };
	if (body != null) {
		headers['Content-Type'] = 'application/json';
		args.post_data = sprintf('%J', body);
	}
	if (!uc.request(method, args)) {
		uc.free();
		return { status: 0, error: 'cannot send the request' };
	}
	uloop.run();
	uc.disconnect();
	uc.free();
	if (length(res.body)) {
		try {
			res.json = json(res.body);
		}
		catch (e) {}
	}
	return res;
}

function describe(r) {
	return r.error ?? sprintf('HTTP %d %s', r.status, r.json?.error ?? '');
}

// mgmt is the status of the interface with the AP's default route. An
// interface whose routes go in a table of their own, such as the one tunnels
// start from on a VLAN (0063), has a default route only there, and is not it.
function mgmt() {
	for (let i in bus.call('network.interface', 'dump')?.interface ?? [])
		if (!i.ip4table)
			for (let r in i.route ?? [])
				if (r.target == '0.0.0.0' && r.mask == 0)
					return i;
	return null;
}

// mgmt_device is the device that holds the default route: the one the AP
// reaches the manager through, and the MAC the DHCP server sees (0040).
function mgmt_device() {
	return mgmt()?.l3_device ?? 'br-lan';
}

// mgmt_interface is the interface that holds the default route, as netifd
// names it ("lan"): the tunnels' underlay (0054).
function mgmt_interface() {
	return mgmt()?.interface;
}

// has_vxlan and has_nft_bridge say whether the packages VXLAN tunnels need
// are installed (0054). The agent never installs them itself. netifd loads
// its protocols only when it starts, so vxlan counts only once netifd knows
// it: after the network was restarted since it was installed (0057).
function has_vxlan() {
	return !!fs.stat('/lib/netifd/proto/vxlan.sh');
}

function vxlan_loaded() {
	return bus.call('network', 'get_proto_handlers')?.vxlan != null;
}

// has_bss_transition says whether hostapd has 802.11v (0057). A running BSS's
// ubus object offers bss_transition_request only then; wpad-basic has none.
// With no BSS running, it is not known: null.
function has_bss_transition() {
	let bss = filter(bus.list() ?? [], o => match(o, /^hostapd\.phy/))[0];
	let methods = bss ? bus.list(bss)?.[0] : null;
	return methods ? 'bss_transition_request' in methods : null;
}

function has_nft_bridge() {
	return system('apk info -e kmod-nft-bridge >/dev/null 2>&1') == 0;
}

// has_prober says whether the prober can run: it needs ucode's socket
// module (0059), which the installer adds.
function has_prober() {
	return !!fs.stat('/usr/lib/ucode/socket.so');
}

// has_veth says whether kmod-veth is installed, which a network with a
// fallback needs for a VLAN transport (0061).
function has_veth() {
	return system('apk info -e kmod-veth >/dev/null 2>&1') == 0;
}

// write_clamp makes the MSS clamp's file from the network config (0054) and
// says whether it changed, so the caller can have fw4 load it. With no
// tunnel to clamp, the table it loaded before is removed too.
function write_clamp(network, aeolus) {
	let text = clamp(network, aeolus);
	if (read(CLAMP) == trim(text))
		return false;
	store(CLAMP, text);
	if (index(text, 'maxseg') < 0)
		system('nft delete table bridge aeolus >/dev/null 2>&1');
	return true;
}

// wake_prober has the prober read its plan now rather than within 10
// seconds: a network with a fallback has no transport until the prober
// attaches one (0061). Radio resource management takes up its settings too
// (0073). A SIGHUP is the same number on every architecture.
function wake_prober() {
	for (let i in ['prober', 'rrm'])
		bus.call('service', 'signal', { name: 'aeolus', instance: i, signal: 1 });
}

function macs() {
	let out = [];
	for (let n in sort(fs.lsdir('/sys/class/net') ?? [])) {
		let m = read(`/sys/class/net/${n}/address`);
		if (m && match(m, /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/) && m != '00:00:00:00:00:00' &&
		    !(int(substr(m, 0, 2), 16) & 1) && index(out, m) < 0)
			push(out, m);
	}
	return slice(out, 0, 32);
}

function radio_list() {
	let out = [];
	cursor().foreach('wireless', 'wifi-device', s => {
		let phy = run(`iwinfo nl80211 phyname ${s['.name']}`);
		let info = match(phy, /^phy[0-9]+$/) ? bus.call('iwinfo', 'info', { device: phy }) : null;
		push(out, { radio: s['.name'], band: s.band, htmodes: info?.htmodes ?? [] });
	});
	return out;
}

// facts is what the AP enrolls with (0033, 0040).
function facts() {
	let b = bus.call('system', 'board') ?? {};
	return {
		mac: read(`/sys/class/net/${mgmt_device()}/address`),
		macs: macs(),
		hostname: read('/proc/sys/kernel/hostname'),
		model: b.model,
		board: b.board_name,
		openwrt: b.release?.version,
		radios: radio_list(),
	};
}

// posix_tz finds a time zone's POSIX string in LuCI's table, if it is there.
function posix_tz(zone) {
	if (!zone)
		return null;
	// Aeolus's own table, which every AP has alike, else LuCI's (0074).
	for (let path in ['/usr/share/ucode/aeolus/zones.uc', '/usr/share/ucode/luci/zoneinfo.uc'])
		for (let line in split(fs.readfile(path) ?? '', '\n')) {
			let m = match(line, /^[ \t]*'([^']+)': '([^']*)',?$/);
			if (m && m[1] == zone)
				return m[2];
		}
	return null;
}

// render_facts is what the renderer needs to know of the AP. ap is its ID,
// as the manager gives it with the config; its segment MACs are made from
// it (0060).
function render_facts(intent, ap) {
	let radios = {};
	for (let r in radio_list())
		radios[r.radio] = { htmodes: r.htmodes };
	return {
		uplink: settings().uplink, management: mgmt_interface(), radios: radios,
		timezone: posix_tz(intent.system?.tz), vxlan: vxlan_loaded(), nft_bridge: has_nft_bridge(),
		bss_transition: has_bss_transition(), ap: ap, prober: has_prober(), veth: has_veth(),
	};
}

function current() {
	let c = cursor();
	let out = {};
	for (let p in PACKAGES)
		out[p] = c.get_all(p) ?? {};
	return out;
}

function running_version() {
	let v = read(RUNNING);
	return v != null && match(v, /^[0-9]+$/) ? int(v) : null;
}

function enroll() {
	let r = http('POST', '/v1/enroll', facts());
	if (r.status == 201 && r.json?.token) {
		store(TOKEN, r.json.token, 384);   // 0600: only root reads the token
		log('enrolled as %s; it waits in Landing Zone until a person adopts it', r.json.ap);
		return 0;
	}
	fail('enrollment: %s', describe(r));
	if (r.status == 409)
		return 3600;   // a person must remove the old entry (0038)
	if (r.status == 503)
		return 600;    // Landing Zone is full
	return 60;
}

// confirm waits until the manager answers again, or gives up (0008).
function confirm() {
	let deadline = time() + CONFIRM;
	sleep(5000);
	while (time() < deadline) {
		if (http('GET', '/healthz').status == 200)
			return true;
		sleep(10000);
	}
	return false;
}

function revert(pending) {
	for (let p in pending.packages ?? []) {
		let b = fs.readfile(`${BACKUP}/${p}`);
		if (b != null)
			store('/etc/config/' + p, b);
	}
	system('reload_config');
	if (write_clamp(cursor().get_all('network'), cursor().get_all('aeolus')))
		system('/etc/init.d/firewall reload >/dev/null 2>&1');
	wake_prober();
	fs.unlink(PENDING);
	fail('reverted to the config before version %s', pending.version);
}

function report_applied(version, hash, ok, error, token) {
	let r = http('POST', '/v1/ap/applied', { version: version, hash: hash, ok: ok, error: error ?? '' }, token);
	if (r.status != 200)
		fail('reporting the apply: %s', describe(r));
}

// wifi_down lists the Wi-Fi networks that are not up: each interface netifd
// lists for a radio that is on, by its SSID and radio (0057).
function wifi_down() {
	let out = [];
	let st = bus.call('network.wireless', 'status') ?? {};
	for (let r in sort(keys(st))) {
		if (st[r].disabled)
			continue;
		for (let i in st[r].interfaces ?? [])
			if (!i.config?.disabled && (!i.ifname || read(`/sys/class/net/${i.ifname}/operstate`) != 'up'))
				push(out, `${i.config?.ssid ?? i.ifname} (${r})`);
	}
	return out;
}

// wifi_back waits for the Wi-Fi to come back after an apply, a radar check
// (DFS) included, and returns the networks that did not, leaving out those
// that were already down before it.
function wifi_back(before) {
	let deadline = time() + WIFI_WAIT;
	let down;
	while (true) {
		down = filter(wifi_down(), n => index(before, n) < 0);
		if (!length(down) || time() >= deadline)
			return down;
		sleep(5000);
	}
}

// hostapd_error is hostapd's last errors, which say why it refused a config:
// the line it could not read, then how many there were.
function hostapd_error() {
	let out = [];
	for (let line in split(run('logread -e hostapd | grep daemon.err | tail -n 2'), '\n')) {
		let m = match(line, /hostapd: (.*)$/);
		if (m)
			push(out, m[1]);
	}
	return length(out) ? substr(join('; ', out), 0, 300) : null;
}

// apply writes the checked packages, reloads, and keeps them only if the
// manager can still be reached (0008, 0040), and if a change to the Wi-Fi
// brought back every network that was up before it (0057).
function apply(out, version, hash) {
	if (!length(out.changed))
		return { ok: true };
	fs.mkdir(BACKUP);
	for (let p in out.changed) {
		let cur = fs.readfile('/etc/config/' + p);
		if (cur != null)
			store(`${BACKUP}/${p}`, cur);
	}
	let wifi = index(out.changed, 'wireless') >= 0;
	let before = wifi ? wifi_down() : [];
	let pending = { version: version, hash: hash, packages: out.changed };
	store(PENDING, sprintf('%J', pending));
	for (let p in out.changed)
		store('/etc/config/' + p, file(out.config[p]));
	log('applying version %d: %s', version, join(', ', out.changed));
	let clamped = write_clamp(out.config.network, out.config.aeolus);
	system('reload_config');
	// fw4 loads the clamp's file; it reloads by itself when its own config
	// changed, so only a changed file alone needs a reload here.
	if (clamped && index(out.changed, 'firewall') < 0)
		system('/etc/init.d/firewall reload >/dev/null 2>&1');
	wake_prober();
	if (!confirm()) {
		revert(pending);
		return { ok: false, error: sprintf('lost the manager within %d seconds of applying; reverted', CONFIRM) };
	}
	let down = wifi ? wifi_back(before) : [];
	if (length(down)) {
		let why = hostapd_error();
		revert(pending);
		return { ok: false, error: sprintf('the Wi-Fi did not come back within %d seconds: %s%s; reverted',
			WIFI_WAIT, join(', ', slice(down, 0, 6)), why ? ` (hostapd: ${why})` : '') };
	}
	fs.unlink(PENDING);
	return { ok: true };
}

// recover finishes an apply that was cut short, by a crash or a reboot.
function recover(token) {
	let p = read(PENDING);
	if (p == null)
		return;
	let pending = json(p);
	log('an apply of version %s did not finish; confirming it', pending.version);
	if (confirm()) {
		fs.unlink(PENDING);
		store(RUNNING, '' + pending.version);
		report_applied(pending.version, pending.hash, true, null, token);
		return;
	}
	revert(pending);
	report_applied(pending.version, pending.hash, false, 'lost the manager after applying; reverted', token);
}

// keep_rrm_key keeps the key radio neighbours sign their hellos with
// (0073), readable by root alone, while the manager sends it beside the
// config; without it, radio resource management stays off. A new key is
// kept before its config is applied. It goes only once a config without it
// runs: one that is refused or reverted leaves the AP on a config that
// still needs the key.
function keep_rrm_key(poll) {
	let key = poll.rrm?.key;
	if (type(key) == 'string' && match(key, /^[0-9a-f]{64}$/)) {
		if (read(RRM_KEY) != key)
			store(RRM_KEY, key + '\n', 384);
	} else if (running_version() == poll.version && fs.access(RRM_KEY))
		fs.unlink(RRM_KEY);
}

// Each exact render is checked and applied at most once per run, so a
// refused or reverted config is not retried every poll.
let attempted = {};

function converge(poll, token) {
	let version = poll.version;
	let intent = poll.config;
	let out = render(intent, current(), render_facts(intent, poll.ap));
	for (let e in out.errors)
		fail('render: %s', e);
	// After a start the whole config comes again, even unchanged. Where it
	// renders to what runs already, there is nothing to check or apply; where
	// a newer agent renders more, that is checked and applied as any change.
	if (!length(out.changed) && version == running_version())
		return;
	let uci = join('\n', map(PACKAGES, p => text(p, p == 'wireless' ? without_keys(out.config[p]) : out.config[p]))) + '\n';
	let key = version + ':' + sha256(uci);
	if (attempted[key])
		return;
	let check = http('POST', '/v1/ap/render', { version: version, uci: uci }, token);
	if (check.status != 200) {
		fail('render check: %s', describe(check));
		return;
	}
	if (check.json.result == 'stale')
		return;
	attempted[key] = true;
	if (check.json.result != 'ok') {
		fail('version %d was refused:', version);
		for (let p in check.json.problems ?? [])
			fail('  %s', p);
		return;
	}
	let result = apply(out, version, check.json.hash);
	report_applied(version, check.json.hash, result.ok, result.error, token);
	if (result.ok) {
		store(RUNNING, '' + version);
		log('running version %d', version);
	}
}

// steering_state says what usteer is doing (0050, 0051): whether it is
// installed and running, its band steering settings, and for each SSID on
// each band, its clients and the clients usteer moved off it and onto it.
function steering_state() {
	if (!fs.stat('/sbin/usteerd'))
		return { installed: false, running: false, interval: 0 };
	let cfg = bus.call('usteer', 'get_config');
	if (!cfg)
		return { installed: true, running: false, interval: 0 };
	let bss = [];
	let info = bus.call('usteer', 'local_info') ?? {};
	for (let name in sort(keys(info))) {
		let n = info[name];
		push(bss, {
			ssid: n.ssid ?? '',
			band: n.freq > 5925 ? '6g' : n.freq > 3000 ? '5g' : '2g',
			clients: n.n_assoc ?? 0,
			steered_away: n.roam_events?.source ?? 0,
			steered_in: n.roam_events?.target ?? 0,
		});
	}
	return {
		installed: true,
		running: true,
		interval: cfg.band_steering_interval ?? 0,
		ssids: slice(cfg.ssid_list ?? [], 0, 64),
		bss: slice(bss, 0, 64),
		bss_transition: has_bss_transition(),
	};
}

// ports_state lists the Ethernet ports of the bridge the uplink is in
// (0053), in the bridge's order: whether each is up, whether it has a link
// and at what speed ("1000F"), and which is the uplink. The ports are those
// the bridge's config lists, as the renderer reads them; the running bridge
// holds the Wi-Fi interfaces too. A tunnel port has left that bridge for its
// tunnels' (0058), on its own or by an 802.1Q device Aeolus made of it, and
// follows the others, by name. The VLAN end of a network's veth pair (0061)
// is in that bridge too, and is not a port.
function ports_state() {
	let uplink = settings().uplink;
	let members = [];
	let bridges = [];
	let vlans = {};   // an 802.1Q device Aeolus made -> the port under it
	cursor().foreach('network', 'device', d => {
		let ports = type(d.ports) == 'array' ? d.ports : d.ports ? [d.ports] : [];
		if (d.type == 'bridge' && index(ports, uplink) >= 0)
			members = filter(ports, e => !match(e, VLAN_END));
		else if (d.type == 'bridge' && match(d['.name'], /^aeolus_[0-9]+_br$/))
			push(bridges, ports);
		else if (d.type == '8021q' && match(d['.name'], /^aeolus_port_/) && d.name && d.ifname)
			vlans[d.name] = d.ifname;
	});
	let tunnel_ports = [];
	for (let ports in bridges)
		for (let e in ports) {
			let p = vlans[e] ?? (match(e, /^aeolus_/) ? null : e);
			if (p != null && index(members, p) < 0 && index(tunnel_ports, p) < 0)
				push(tunnel_ports, p);
		}
	members = [...members, ...sort(tunnel_ports)];
	let devs = bus.call('network.device', 'status') ?? {};
	let out = [];
	for (let p in members) {
		let d = devs[p] ?? {};
		push(out, { name: p, up: !!d.up, carrier: !!d.carrier, speed: d.carrier ? d.speed ?? '' : '', uplink: p == uplink });
	}
	return slice(out, 0, 32);
}

// probes reads what the prober found (0059), if it is recent: by VNI, how
// each tunnel is doing, and the ports the loop guard took off their tunnels.
function probes() {
	let p = null;
	try {
		p = json(read(PROBES) ?? 'null');
	} catch (e) {
	}
	if (type(p?.at) != 'int' || time() - p.at > PROBES_STALE)
		return null;
	return p;
}

// vxlan_state says what the AP's tunnels are doing (0054): whether the
// packages they need are there, the MTU its uplink carries now, which the
// tunnels run over (0056), and for each tunnel Aeolus made, its VNI, peer,
// port and MTU, the VLAN it starts from and the AP's address there (0063),
// whether it is up, or standing by as a fallback, and what the prober found
// (0059); and the ports the loop guard took off.
function vxlan_state() {
	let found = probes();
	let tunnels = [];
	cursor().foreach('network', 'interface', s => {
		let vni = match(s['.name'], /^aeolus_([0-9]+)$/)?.[1];
		if (!vni || !(s.proto in { vxlan: 1, vxlan6: 1 }))
			return;
		let up = !!bus.call(`network.interface.${s['.name']}`, 'status')?.up;
		let t = {
			vni: int(vni), peer: s.peeraddr ?? s.peer6addr ?? '', port: int(s.port ?? '4789'),
			mtu: int(s.mtu ?? '0'), up: up, standby: !up && s.auto == '0',
		};
		// A tunnel that starts from a VLAN (0063): which, and the AP's address
		// there, which it has only once DHCP answers.
		let start = match(s.tunlink ?? '', /^aeolus_vlan([0-9]+)_tunnels$/);
		if (start) {
			t.from_vlan = int(start[1]);
			let a = bus.call(`network.interface.${s.tunlink}`, 'status')?.['ipv4-address']?.[0]?.address;
			if (a)
				t.from_address = a;
		}
		let f = found?.tunnels?.[vni];
		if (f)
			t.probe = {
				verdict: f.verdict, interval: f.interval, asks: slice(f.asks ?? [], 0, 8),
				underlay: f.underlay, underlay_ms: f.underlay_ms, from: f.from, rtt_ms: f.rtt_ms,
				answered_ago: f.answered_ago, lease: f.lease,
			};
		push(tunnels, t);
	});
	let uplink_mtu = int(read(`/sys/class/net/${mgmt_device()}/mtu`) ?? '0');
	return {
		installed: has_vxlan(), loaded: vxlan_loaded(), clamp: has_nft_bridge(),
		prober: has_prober(), uplink_mtu: uplink_mtu, tunnels: slice(tunnels, 0, 64),
		loops: slice(found?.loops ?? [], 0, 32),
	};
}

// transports_state says, for each network with a fallback (0061), which
// transport carries it now, and how each is doing, by the prober's verdicts;
// its last switch, and why a switch that is due cannot be made.
function transports_state() {
	let out = {};
	for (let id, s in probes()?.switches ?? {}) {
		let x = { active: s.active, primary: s.primary, fallback: s.fallback };
		if (type(s.last?.at) == 'int')
			x.last_switch = { from: s.last.from, to: s.last.to, why: s.last.why, ago: max(0, time() - s.last.at) };
		if (s.cannot)
			x.cannot_switch = s.cannot;
		out[id] = x;
	}
	return length(out) ? out : null;
}

// vlan_probes says what the prober found on the VLAN transports of networks
// with a fallback (0061), as vxlan_state does for tunnels.
function vlan_probes() {
	let out = [];
	for (let vlan, f in probes()?.vlans ?? {})
		push(out, {
			vlan: int(vlan), tagged: !!f.tagged, probe: {
				verdict: f.verdict, interval: f.interval, asks: slice(f.asks ?? [], 0, 8),
				underlay: f.underlay, underlay_ms: null, from: f.from, rtt_ms: f.rtt_ms,
				answered_ago: f.answered_ago, lease: f.lease,
			},
		});
	return length(out) ? slice(out, 0, 64) : null;
}

// uplink_state says which of the VLANs watched on the uplink reach the AP
// from the switch, and all the switch's LLDP says of itself and of the
// uplink's port (0064), as the prober found and read it.
function uplink_state() {
	let u = probes()?.uplink;
	let vlans = [];
	for (let v in sort(keys(u?.vlans ?? {}), (a, b) => +a - +b)) {
		let w = u.vlans[v];
		push(vlans, { vlan: int(v), tagged: !!w.tagged, verdict: w.verdict, heard_ago: w.heard_ago });
	}
	return { vlans: length(vlans) ? slice(vlans, 0, 64) : null, neighbor: u?.neighbor };
}

// uplink_port is what the AP knows of its uplink itself (0064): its name,
// MAC and MTU; how often its link has come and gone; the VLANs it carries
// as the network config has them, Aeolus's and the AP's own, tagged or not,
// and which is the management VLAN; and its counters since it came up.
function uplink_port() {
	let up = settings().uplink;
	if (!up || read(`/sys/class/net/${up}/address`) == null)
		return null;
	let num = (k) => int(read(`/sys/class/net/${up}/${k}`) ?? '0');
	let vlans = {};
	cursor().foreach('network', 'bridge-vlan', v => {
		for (let e in (type(v.ports) == 'array' ? v.ports : v.ports ? [v.ports] : []))
			if (split(e, ':')[0] == up && match(v.vlan ?? '', /^[0-9]+$/))
				vlans[v.vlan] = index(split(e, ':')[1] ?? '', 't') >= 0;
	});
	let mgmt = match(mgmt_device() ?? '', /\.([0-9]+)$/)?.[1];
	return {
		name: up, mac: read(`/sys/class/net/${up}/address`), mtu: num('mtu'), carrier_changes: num('carrier_changes'),
		vlans: slice(map(sort(keys(vlans), (a, b) => +a - +b), v => ({ vlan: int(v), tagged: vlans[v] })), 0, 4094),
		management_vlan: mgmt ? int(mgmt) : null,
		rx_bytes: num('statistics/rx_bytes'), tx_bytes: num('statistics/tx_bytes'),
		rx_packets: num('statistics/rx_packets'), tx_packets: num('statistics/tx_packets'),
		rx_errors: num('statistics/rx_errors'), tx_errors: num('statistics/tx_errors'),
		rx_dropped: num('statistics/rx_dropped'), tx_dropped: num('statistics/tx_dropped'),
	};
}

// probe_news is what, of the prober's results, is worth a state report as
// soon as it changes: each tunnel's verdict, where each network with a
// fallback is and whether it cannot switch, whether each VLAN watched on the
// uplink reaches the AP, the switch and port the uplink is on, each
// network's DHCP findings, which Wi-Fi clients are on the AP, and the loops
// it found.
function probe_news() {
	let p = probes();
	if (!p)
		return '';
	let v = map(sort(keys(p.tunnels ?? {})), k => k + '=' + p.tunnels[k].verdict);
	push(v, ...map(sort(keys(p.vlans ?? {})), k => 'vlan' + k + '=' + p.vlans[k].verdict));
	push(v, ...map(sort(keys(p.switches ?? {})), k => k + ':' + p.switches[k].active + (p.switches[k].cannot ? '!' : '')));
	push(v, ...map(sort(keys(p.uplink?.vlans ?? {})), k => 'uplink' + k + '=' + p.uplink.vlans[k].verdict));
	let n = p.uplink?.neighbor;
	if (n)
		push(v, 'switch=' + (n.system ?? n.chassis ?? '') + '/' + (n.port ?? '') + '/' + join(' ', n.vlans ?? []));
	// Each network's DHCP (0065): whether anything answers, how many servers
	// answered one request, and which clients don't use DHCP.
	for (let id in sort(keys(p.dhcp ?? {}))) {
		let d = p.dhcp[id];
		push(v, sprintf('dhcp:%s=%s/%d/%s', id, d.unanswered > 0 && !d.answered ? 'silent' : 'ok', length(d.duplicates ?? []) ? 2 : 1,
			join(' ', sort(map(d.without ?? [], c => c.mac + (c.address ? '' : '!'))))));
	}
	// The Wi-Fi clients on the AP (0066): one joining or leaving.
	push(v, 'clients=' + join(' ', sort(map(p.clients ?? [], c => c.mac))));
	let l = map(p.loops ?? [], x => x.port);
	return join(',', v) + ';' + join(',', l);
}

// time_state is whether the AP's clock is synchronized, as ntpd last said
// through its hotplug (0069): null until it has said; its stratum and offset;
// seconds since it said so; and the time servers ntpd was started with.
function time_state() {
	let servers = [];
	for (let pid in split(run('pidof ntpd'), ' ')) {
		let a = split(fs.readfile(`/proc/${pid}/cmdline`) ?? '', chr(0));
		for (let i = 0; i + 1 < length(a); i++)
			if (a[i] == '-p')
				push(servers, a[i + 1]);
		if (length(servers))
			break;
	}
	let t = null;
	try {
		t = json(fs.readfile(TIME) ?? 'null');
	}
	catch (e) {
		t = null;
	}
	let up = int(split(read('/proc/uptime') ?? '0', ' ')[0]);
	let ago = t?.at != null ? up - int(t.at) : null;
	return {
		synced: t == null ? null : t.action != 'unsync' && t.action != 'other' && t.stratum < 16,
		stratum: t?.stratum, offset: t?.offset, ago: ago != null && ago >= 0 ? ago : null,
		servers: slice(uniq(servers), 0, 8),
	};
}

// rrm_state reads what radio resource management found (0073), while it is
// on and its results are recent.
function rrm_state() {
	let r = null;
	try {
		r = json(read(RRM) ?? 'null');
	} catch (e) {
	}
	if (r?.on != true || type(r.at) != 'int' || time() - r.at > PROBES_STALE)
		return null;
	return {
		address: r.address ?? '', advertised: r.advertised ?? [], neighbours: r.neighbours ?? [], ratings: r.ratings ?? [],
		moves: r.moves ?? [], apc: r.apc ?? [],
	};
}

// state_report is what the AP tells the manager about itself (0039).
function state_report(running) {
	let b = bus.call('system', 'board') ?? {};
	let radios = [];
	let status = bus.call('network.wireless', 'status') ?? {};
	for (let name in sort(keys(status))) {
		let band = status[name].config?.band;
		if (!(band in { '2g': 1, '5g': 1, '6g': 1 }))
			continue;
		// Whether the radio is up, and the power it sends at, in dBm, are
		// what it runs, whether or not Aeolus sets them.
		let r = { radio: name, band: band, channel: 0, width: 0, clients: 0, up: status[name].up == true };
		for (let i in status[name].interfaces ?? []) {
			if (!i.ifname)
				continue;
			let info = bus.call('iwinfo', 'info', { device: i.ifname });
			if (info?.channel)
				r.channel = info.channel;
			if (type(info?.txpower) == 'int' && info.txpower >= 0 && info.txpower <= 40)
				r.txpower = info.txpower;
			let w = match(info?.htmode ?? '', /([0-9]+)/);
			if (w)
				r.width = int(w[1]);
			r.clients += length(keys(bus.call(`hostapd.${i.ifname}`, 'get_clients')?.clients ?? {}));
		}
		push(radios, r);
	}
	let report = {
		version: running ?? 0,
		uptime: int(split(read('/proc/uptime') ?? '0', ' ')[0]),
		openwrt: b.release?.version ?? '',
		radios: slice(radios, 0, 8),
		steering: steering_state(),
		ports: ports_state(),
		vxlan: vxlan_state(),
	};
	// Only where there are networks with a fallback (0061).
	let tr = transports_state(), vp = vlan_probes();
	if (tr)
		report.transports = tr;
	if (vp)
		report.vlan_probes = vp;
	// The VLANs watched on the uplink, and its switch (0064).
	let up = uplink_state();
	if (up.vlans)
		report.uplink_vlans = up.vlans;
	if (up.neighbor)
		report.uplink_neighbor = up.neighbor;
	let port = uplink_port();
	if (port)
		report.uplink_port = port;
	// The clients' DHCP on each Aeolus network, as the prober found (0065).
	let dhcp = probes()?.dhcp;
	if (dhcp && length(keys(dhcp)))
		report.dhcp = dhcp;
	// Every Wi-Fi client on the AP, as the prober found (0066).
	let clients = probes()?.clients;
	if (clients && length(clients))
		report.clients = slice(clients, 0, 256);
	// Its clock (0069).
	report.time = time_state();
	// The per-user keys it has (0070).
	let have = read(KEYS_VERSION);
	if (have)
		report.keys = { version: have, count: length(filter(values(cursor().get_all('wireless') ?? {}),
			s => s['.type'] == 'wifi-station' && index(s['.name'], 'aeolus_key_') == 0)) };
	// Its radio neighbours (0073).
	let rr = rrm_state();
	if (rr)
		report.rrm = rr;
	return report;
}

function report_state(running, token) {
	let res = http('POST', '/v1/ap/state', state_report(running), token);
	if (res.status != 200)
		fail('state report: %s', describe(res));
}

// keys_digest is a digest of the key agent's sections in the wireless config,
// to tell whether something else, such as a revert, changed them since it
// wrote them (0070).
function keys_digest() {
	let parts = [];
	for (let k, v in cursor().get_all('wireless') ?? {})
		if (v['.type'] == 'wifi-station' && index(k, 'aeolus_key_') == 0)
			push(parts, sprintf('%J', [k, v.iface, v.mac, v.key, v.vid]));
	return sha256(join('\n', sort(parts)));
}

// write_keys writes an AP's whole key set as wifi-station sections, named
// aeolus_key_<id>, through the UCI library in this process (the uci command
// is far too slow for many keys), and has the wireless config reloaded:
// hostapd rewrites its PSK files and reloads them without dropping a client
// (0070). Each key goes on its network's wifi-ifaces here; a key whose form
// is wrong is skipped. It returns how many keys it wrote.
function write_keys(set) {
	let c = cursor();
	let w = c.get_all('wireless') ?? {};
	let radios = filter(keys(w), k => w[k]['.type'] == 'wifi-device');
	let want = {};
	for (let id, net in set.networks ?? {}) {
		let ifaces = filter(map(radios, r => iface_name(id, r)), n => w[n]?.['.type'] == 'wifi-iface');
		if (!length(ifaces))
			continue;
		for (let k in net.keys ?? []) {
			if (!match(k.id ?? '', /^[a-z0-9][a-z0-9-]*$/) || length(k.id) > 32 || !match(k.psk ?? '', /^[0-9a-f]+$/) || length(k.psk) != 64)
				continue;
			if (k.vlan != null && (type(k.vlan) != 'int' || k.vlan < 1 || k.vlan > 4094))
				continue;
			let macs = filter(k.macs ?? [], m => match(m, /^[0-9a-f][0-9a-f](:[0-9a-f][0-9a-f])+$/) && length(m) == 17);
			want['aeolus_key_' + replace(k.id, /-/g, '_')] = {
				iface: ifaces, mac: length(macs) ? macs : ['00:00:00:00:00:00'], key: k.psk, vid: k.vlan,
			};
		}
	}
	for (let k, v in w)
		if (v['.type'] == 'wifi-station' && index(k, 'aeolus_key_') == 0 && !want[k])
			c.delete('wireless', k);
	for (let name, o in want) {
		c.set('wireless', name, 'wifi-station');
		c.set('wireless', name, 'iface', o.iface);
		c.set('wireless', name, 'mac', o.mac);
		c.set('wireless', name, 'key', o.key);
		if (o.vid)
			c.set('wireless', name, 'vid', '' + o.vid);
		else
			c.delete('wireless', name, 'vid');
	}
	c.commit('wireless');
	system('ubus call network reload >/dev/null 2>&1');
	return length(keys(want));
}

// keys_main is the key agent (0070), a procd instance of its own: it asks the
// manager for the AP's per-user keys with the version it has, and the manager
// holds the request until they change. A new set is written at once. Where
// something else changed the key agent's sections, such as a revert of the
// wireless config, they are written again.
function keys_main() {
	uloop.init();
	signal('SIGTERM', () => exit(0));
	signal('SIGINT', () => exit(0));
	let have = read(KEYS_VERSION), wrote = null;
	while (true) {
		let token = read(TOKEN);
		if (!token) {
			sleep(30000);
			continue;
		}
		if (wrote != null && keys_digest() != wrote)
			have = null;   // changed behind it: ask for the whole set again
		let r = http('GET', `/v1/ap/keys?wait=${KEYS_WAIT}`, null, token,
			have ? { 'If-None-Match': `"${have}"` } : null, (KEYS_WAIT + 15) * 1000);
		if (r.status == 200 && match(r.json?.version ?? '', /^[0-9a-f]+$/)) {
			let n = write_keys(r.json);
			have = r.json.version;
			store(KEYS_VERSION, have + '\n', 0600);
			wrote = keys_digest();
			log('per-user keys: version %s, %d %s', have, n, n == 1 ? 'key' : 'keys');
		}
		else if (r.status == 304) {
			wrote ??= keys_digest();
		}
		else {
			if (r.status != 401)
				fail('keys: %s', describe(r));
			sleep(30000);
		}
	}
}

// packages points the AP's package feeds at the manager, and after a
// sysupgrade has the packages Aeolus needs installed again from it, in the
// background, since that can take a while and may restart the network
// (0069). It returns when it next wants to look.
function packages(now) {
	if (!fs.access(PACKAGES_TOOL))
		return now + RESTORE_EVERY;
	system(PACKAGES_TOOL + ' feeds >/dev/null 2>&1');
	if (!fs.access(PACKAGES_DONE))
		system('setsid ' + PACKAGES_TOOL + ' restore </dev/null >/dev/null 2>&1 &');
	return now + RESTORE_EVERY;
}

function main() {
	uloop.init();
	// uloop's own handlers only act inside uloop.run(), and the agent spends
	// its time asleep, so stop on these ourselves. Stopping during an apply
	// is safe: the pending marker makes the next start finish or revert it.
	signal('SIGTERM', () => exit(0));
	signal('SIGINT', () => exit(0));
	recover(read(TOKEN));
	// The clamp's file is not kept over a sysupgrade, so make it again.
	if (write_clamp(cursor().get_all('network'), cursor().get_all('aeolus')))
		system('/etc/init.d/firewall reload >/dev/null 2>&1');
	let next_packages = packages(time());
	let running = running_version();
	let assigned = false;
	let held = null;
	let last_state = 0;
	let news = probe_news();
	// The first poll after a start asks for the config whole, not only
	// whether it changed, so an updated agent renders what it already runs
	// with its own renderer, and applies what that adds.
	let whole = true;
	while (true) {
		let token = read(TOKEN);
		if (!token) {
			let wait = enroll();
			if (wait > 0) {
				sleep(wait * 1000);
				continue;
			}
			token = read(TOKEN);
		}
		let extra = running != null && !whole ? { 'If-None-Match': `"${running}"` } : null;
		let r = http('GET', '/v1/ap/config', null, token, extra);
		if (r.status == 401) {
			log('the manager no longer knows this AP; enrolling again');
			fs.unlink(TOKEN);
			assigned = false;
			continue;
		}
		if (r.status == 304) {
			assigned = true;
		}
		else if (r.status == 200) {
			whole = false;
			let state = r.json?.state;
			assigned = state != 'unassigned';
			if (state == 'ready') {
				keep_rrm_key(r.json);
				converge(r.json, token);
				keep_rrm_key(r.json);
				let now = running_version();
				if (now != running) {
					running = now;
					last_state = 0;
				}
			}
			else if (state == 'held' && held != r.json.version) {
				held = r.json.version;
				note('version %d is held by the manager; keeping what runs:', held);
				for (let p in r.json.problems ?? [])
					note('  %s', p);
			}
		}
		else {
			fail('poll: %s', describe(r));
		}
		// A tunnel that went down or came back, or a loop, is reported at
		// once rather than with the next state report (0059).
		let now_news = probe_news();
		if (now_news != news) {
			news = now_news;
			last_state = 0;
		}
		if (assigned && time() - last_state >= STATE_EVERY) {
			report_state(running, token);
			last_state = time();
		}
		if (time() >= next_packages && !fs.access(PACKAGES_DONE))
			next_packages = packages(time());
		let poll = settings().poll;
		sleep(poll * 1000 * (90 + math.rand() % 21) / 100);
	}
}

switch (ARGV[0]) {
case 'facts':
	print(sprintf('%.J\n', facts()));
	break;
// state prints the state report and the facts the agent renders with, and
// sends nothing: it runs the agent's own code where it can be seen.
case 'state':
	print(sprintf('%.J\n', { report: state_report(running_version()), render: render_facts({}, null) }));
	break;
case 'keys':
	keys_main();
	break;
case 'ping': {
	let r = http('GET', '/healthz');
	print(r.status == 200 ? sprintf('manager reachable: %s\n', r.body) : sprintf('cannot reach the manager: %s\n', describe(r)));
	exit(r.status == 200 ? 0 : 1);
}
default:
	main();
}

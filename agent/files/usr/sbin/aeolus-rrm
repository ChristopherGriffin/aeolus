#!/usr/bin/ucode -S
// aeolus-rrm: the Aeolus agent's radio resource management (0073), its
// control plane: the AP's neighbours.
//
// Its beacons say it is an Aeolus AP and where to reach it: on each radio,
// one of its networks, Aeolus's own where it has one, carries a vendor
// element with its AP ID and its management address. It listens for the
// others' on its channels, visiting one at a time, briefly, every few
// seconds, and less while the radio is busy. On each band, the three APs it
// hears most strongly become its neighbours.
//
// Neighbours exchange hellos over the wire, from management address to
// management address, signed with the key the manager gives, so nothing
// else on the LAN can pose as one. A hello says its radios, how strongly it
// hears the APs it hears, and whose hellos it gets. An AP whose hellos come
// is a neighbour too, though it isn't among the three this one hears best.
// A neighbour is up when hellos go both ways, and down when its hellos stop.
//
// Each visit rates the channel visited, as a cost, lower being better: how
// busy others kept it, its noise, and the other networks heard on it. Each
// channel keeps a lasting rating, which it earns over many visits, and one
// for now. A channel a neighbour on that band uses is blotted out.
//
// It moves a radio whose channel is automatic to its best channel on the
// band, where that is clearly better: at once when the radio has just
// started, or interference suddenly fills its channel; otherwise only in
// the policy's window. It claims the channel in its hellos first, and waits.
// Where two neighbours claim at once, the one whose channel rates worse
// moves first. The move is hostapd's channel switch announcement, which
// clients that support it follow without reconnecting.
//
// Where power control is on (0077), it holds each radio's power where the
// neighbours it looks for hear it at the target, by their hellos: a step up
// or down at most every ten minutes, between a floor and the power the radio
// is configured to.
//
// Its settings are the agent's own UCI package, as the renderer made it,
// and the key the agent keeps. What it finds goes to
// /var/run/aeolus/rrm.json, which the agent reports. procd runs it beside
// the agent.
//
//	aeolus-rrm [-c <UCI directory>] [-o <results file>] [-k <key file>]
//
// -c, -o and -k are for trying it out beside the one procd runs.

'use strict';

import * as fs from 'fs';
import * as socket from 'socket';
import { cursor } from 'uci';
import { connect } from 'ubus';
import { openlog, syslog, LOG_PID, LOG_DAEMON, LOG_INFO, LOG_WARNING } from 'log';
import * as rrm from 'aeolus.rrm';

let nl = require('nl80211');

// The key hellos are signed with is the manager's, which the agent keeps.
let confdir = null, out = '/var/run/aeolus/rrm.json', keyfile = '/etc/aeolus/rrm.key';
for (let i = 0; i < length(ARGV); i++) {
	if (ARGV[i] == '-c')
		confdir = ARGV[++i];
	else if (ARGV[i] == '-o')
		out = ARGV[++i];
	else if (ARGV[i] == '-k')
		keyfile = ARGV[++i];
}

const LOOK_EVERY = 10;      // seconds between looks at the settings, the radios and the address
const VISIT_EVERY = 15;     // seconds between a radio's visits to a channel
const VISIT_WAIT = 2;       // seconds a visit is given before its results are read
const BUSY = 0.6;           // a radio's own channel busier than this puts off a visit elsewhere
const PUT_OFF = 4;          // visits put off in a row at most
const HEARD_FOR = 1200;     // seconds an AP stays heard after it was last heard in the air
const OTHERS_FOR = 3600;    // seconds a network that is not Aeolus's stays listed after it was heard (0105)
const OTHERS_MAX = 64;      // and how many, the strongest
const FORGET = 900;         // seconds after which a neighbour that went down is forgotten
const WRITE_EVERY = 5;      // seconds between writes of the results
const SCAN_FLAG_AP = 4;     // NL80211_SCAN_FLAG_AP: scan on an AP's own interface
const LISTED = 64;          // other APs reported at most
const RATED_FOR = 1800;     // seconds a channel's rating is kept without a visit
const RATED = 64;           // channel ratings reported at most
const HOLD = 30;            // seconds a move is claimed in hellos before it is made
const STEADY = 600;         // seconds a planned move's reason must hold first
const COOL = 900;           // seconds a radio stays put after it moved, or a move failed
const START = 600;          // seconds after a radio starts in which it moves at once
const SETTLE = 20;          // seconds after a neighbour's claim ends before this AP claims
const WARM_UP = 60;         // seconds the daemon runs before it moves anything
const HOT = 3;              // own-channel reads in a row, busier than rrm.SUDDEN, that are interference
const ANNOUNCE = 10;        // beacons a channel switch is announced for
const KEPT = 16;            // moves reported at most
const WHYS = ['start', 'shared', 'better', 'interference'];
const STATES = ['announced', 'moved', 'yielded', 'withdrawn', 'failed'];
const APC_EVERY = 600;      // seconds between a radio's power steps (0077)
const DEAF_AFTER = 3;       // visits refused in a row before a radio is said not to scan

let bus = connect();
openlog('aeolus-rrm', LOG_PID, LOG_DAEMON);

function log(fmt, ...args) {
	syslog(LOG_INFO, fmt, ...args);
}

function note(fmt, ...args) {
	syslog(LOG_WARNING, fmt, ...args);
}

function read(path) {
	let v = fs.readfile(path);
	return v == null ? null : trim(v);
}

function store(path, data) {
	let tmp = path + '.new';
	if (fs.writefile(tmp, data) == null)
		return false;
	return fs.rename(tmp, path);
}

// now is monotonic time in seconds, to the microsecond.
function now() {
	let c = clock(true);
	return c[0] + c[1] / 1e9;
}

function dbm(v) {
	return type(v) in ['int', 'double'] && v >= -127 && v <= 0 ? int(v < 0 ? v - 0.5 : v) : null;
}

let cfg = { on: false };
let address = null;   // the AP's management address, where its neighbours reach it
let sock = null;
let radios = {};      // radio -> { band, bss, index, channel, width, mode, dfs, pinned, started, list, next, due, put_off, survey, scan, hot, claim, plan }
let adverts = {};     // the network carrying a radio's element -> { hex, index }
let heard = {};       // AP -> { address, port, bands: { <band>: { signal, at } } }
let others = {};      // a BSSID heard that is not an Aeolus AP's -> { ssid, band, channel, signal, at } (0105)
let aeolus_bss = {};  // the last five bytes of a BSSID that carried an Aeolus advert -> when (0105)
let nbrs = {};        // AP -> { address, port, last: { at, seq }, at, msg, state }
let chosen = {};      // AP -> true, among the three heard most strongly on a band
let picks = {};       // band -> the APs heard most strongly there
let rates = {};       // '<band> <channel>' -> { band, channel, cost, now, busy, noise, networks, visits, at }
let moves = [];       // this AP's last moves: { band, from, to, why, state, at, ap }
let claimed = {};     // band -> when a neighbour's claim there was last seen
let gone = false;     // whether netifd's network.wireless object is gone, so no radio can be seen
let held = {};        // radio -> the power control holds it at (0077): { band, phy, index, power, ceiling, at, step, why, count, weakest, stepped }
let kept = {};        // radio -> { band, power }: what the daemon's last run held it at
let began = 0;        // when the daemon started
let looked = false;   // whether it has looked at the radios since it started, or was turned on
let seq = 0;

// settings reads whether RRM is on, the AP it advertises, the key, the
// policy for moves: whether to move, the window for planned moves, and the
// margin a better channel must beat the radio's own by; and whether power
// control is on, how many neighbours it looks for, and its target (0077).
function settings() {
	let s = cursor(confdir).get_all('aeolus', 'aeolus_rrm');
	let key = rrm.unhex(read(keyfile) ?? '');
	let on = s?.['.type'] == 'rrm' && s.enabled == '1' && match(s.ap ?? '', /^ap-[0-9a-f]{12}$/) != null && key != null && length(key) >= 16;
	let margin = int(s?.margin ?? rrm.MARGIN);
	let wanted = int(s?.apc_neighbours ?? 3), target = int(s?.apc_target ?? -70);
	return {
		on: on, ap: s?.ap, key: key, moves: s?.moves != '0',
		window: rrm.window(s?.window ?? rrm.WINDOW) ?? rrm.window(rrm.WINDOW),
		margin: margin >= 5 && margin <= 100 ? margin : rrm.MARGIN,
		apc: s?.apc == '1', wanted: wanted >= 1 && wanted <= 6 ? wanted : 3,
		target: target >= -85 && target <= -50 ? target : -70,
	};
}

// management is the address of the interface that holds the default route,
// as the agent finds its management (0040).
function management() {
	for (let i in bus.call('network.interface', 'dump')?.interface ?? [])
		if (!i.ip4table)
			for (let r in i.route ?? [])
				if (r.target == '0.0.0.0' && r.mask == 0)
					return i['ipv4-address']?.[0]?.address;
	return null;
}

function ifindex(name) {
	return read(`/sys/class/net/${name}/ifindex`);
}

// uptime is how long the AP has been up, in seconds.
function uptime() {
	return int(split(read('/proc/uptime') ?? '0', ' ')[0]);
}

// calm forgets what a radio's channel was like: its survey's counts, and
// whether it was busy with interference. They are another channel's once it
// moves.
function calm(r) {
	r.survey = null;
	r.hot = null;
	r.hot_n = 0;
	r.hot_sum = 0;
}

function record(m) {
	push(moves, m);
	if (length(moves) > KEPT)
		moves = slice(moves, length(moves) - KEPT);
}

// end_claim ends a radio's claim: moved, yielded to a neighbour's claim
// (ap's), withdrawn, or failed.
function end_claim(r, how, ap) {
	let m = r.claim.move;
	m.state = how;
	m.at = time();
	if (ap)
		m.ap = ap;
	r.claim = null;
	r.plan = null;
	log('%s: the move from channel %d to %d: %s%s', r.band, m.from, m.to, how, ap ? ' to ' + ap : '');
}

// phy_of is the wiphy a network is on. Power is set for the wiphy.
function phy_of(ifn) {
	let p = read(`/sys/class/net/${ifn}/phy80211/name`);
	return p != null && match(p, /^phy[0-9]+$/) ? p : null;
}

// set_power holds a wiphy's power at p dBm, or with null lets it go back to
// what it is configured to, as netifd does when the radio starts (0077).
function set_power(phy, p) {
	return system(p == null ? `iw phy ${phy} set txpower auto` : sprintf('iw phy %s set txpower fixed %d', phy, p * 100)) == 0;
}

// let_go puts the radios power control holds back to their configured power.
// One whose power is set, or whose network was made anew, netifd already
// put back. One that can't be put back yet stays held, failed, to be tried
// again next time. What the last run held them at is forgotten too.
function let_go() {
	let still = {};
	for (let name, h in held) {
		let r = radios[name];
		if (!r || h.power == null || r.power_set || r.phy != h.phy || r.index != h.index)
			continue;
		if (set_power(h.phy, null)) {
			log('%s: power control let go of its power', r.band);
			continue;
		}
		if (h.why != 'failed')
			note('%s: power control cannot let go of its power; it tries again', r.band);
		h.why = 'failed';
		still[name] = h;
	}
	held = still;
	kept = {};
}

// look_radios finds the radios that are up, and on each, the network whose
// beacons carry the element: Aeolus's own where it has one. A radio counts
// as started when that network's interface is made anew, or when it comes
// up while the daemon runs; one the daemon finds up when it starts, only if
// the AP booted within START.
function look_radios(at) {
	let seen = {};
	// netifd's network.wireless object can go while netifd runs on (OpenWrt
	// 25.12 publishes it once, from ucode): the radios run, unseen, until the
	// network restarts (2026-10-06, the office AP).
	let status = bus.call('network.wireless', 'status');
	let lost = status == null && !!match(bus.error() ?? '', /not found/i);
	if (lost != gone) {
		if (lost)
			note('netifd has no network.wireless object: no radio can be seen until the network restarts');
		else
			log('netifd has its network.wireless object again');
		gone = lost;
	}
	for (let name, d in status ?? {}) {
		let band = d.config?.band;
		if (!(band in ['2g', '5g', '6g']) || !d.up)
			continue;
		let ifs = filter(d.interfaces ?? [], i => i.ifname && i.config?.mode == 'ap');
		if (!length(ifs))
			continue;
		let pick = filter(ifs, i => index(i.section ?? '', 'aeolus_') == 0)[0] ?? ifs[0];
		let info = bus.call('iwinfo', 'info', { device: pick.ifname }) ?? {};
		let idx = ifindex(pick.ifname);
		let fresh = !radios[name];
		let r = radios[name] ??= { next: 0, due: at + 2 + 5 * length(keys(radios)), put_off: 0 };
		if (fresh)
			r.started = looked || uptime() < START ? at : null;
		else if (r.bss != pick.ifname || r.index != idx)
			r.started = at;
		r.index = idx;
		let ch = info.channel ?? 0;
		// The survey's running counts are another network's or another
		// channel's once any of these change: they start again.
		if (r.band != band || r.bss != pick.ifname || r.channel != ch)
			calm(r);
		r.band = band;
		r.bss = pick.ifname;
		r.channel = ch;
		r.width = int(match(info.htmode ?? '', /([0-9]+)$/)?.[1] ?? 20);
		r.mode = info.htmode;
		r.dfs = !(d.config?.acs_exclude_dfs in [true, '1']);
		// A channel set for the radio is left alone, and so is a power.
		let set = d.config?.channel;
		r.pinned = !(set == null || set == 'auto' || set == '0' || set == 0);
		r.power_set = !(d.config?.txpower in [null, '']);
		r.phy = phy_of(pick.ifname);
		// The channels an automatic channel may be (0075), as the renderer
		// wrote them: whole blocks at the radio's width.
		let chans = d.config?.channels;
		chans = type(chans) == 'array' ? chans : type(chans) == 'string' ? split(trim(chans), /[ \t]+/) : [];
		r.allowed = length(chans) ? map(chans, c => int(c)) : null;
		r.list = rrm.visits(band, r.channel, r.dfs, r.allowed);
		seen[name] = true;
	}
	for (let name in keys(radios))
		if (!seen[name])
			delete radios[name];
	looked = true;
}

// advertise puts the element on each radio's chosen network, again whenever
// that network's interface was made anew, and takes it off where it no
// longer belongs.
function advertise() {
	let want = {};
	if (cfg.on && address)
		for (let name, r in radios) {
			let hex = rrm.advert(cfg.ap, address, rrm.PORT);
			if (hex)
				want[r.bss] = hex;
		}
	for (let ifn, hex in want) {
		let idx = ifindex(ifn);
		if (adverts[ifn]?.hex == hex && adverts[ifn].index == idx)
			continue;
		bus.call(`hostapd.${ifn}`, 'set_vendor_elements', { vendor_elements: hex });
		let err = bus.error();
		if (err)
			note('%s: its beacons cannot carry the element: %s', ifn, err);
		else
			adverts[ifn] = { hex: hex, index: idx };
	}
	for (let ifn in keys(adverts))
		if (!want[ifn]) {
			bus.call(`hostapd.${ifn}`, 'set_vendor_elements', { vendor_elements: '' });
			delete adverts[ifn];
		}
}

// listen opens the socket hellos come in on, at the management address.
function listen() {
	if (sock) {
		sock.close();
		sock = null;
	}
	if (!address)
		return;
	let s = socket.create(socket.AF_INET, socket.SOCK_DGRAM);
	if (!s || !s.bind({ address: address, port: rrm.PORT })) {
		note('cannot listen on %s:%d: %s', address, rrm.PORT, socket.error());
		s?.close();
		return;
	}
	sock = s;
	log('listening for hellos on %s:%d', address, rrm.PORT);
}

function look(at) {
	let was = cfg.on;
	cfg = settings();
	if (cfg.on != was)
		log(cfg.on ? 'on, as %s' : 'off', cfg.ap);
	if (!cfg.on) {
		for (let name, r in radios)
			if (r.claim)
				end_claim(r, 'withdrawn');
		// A power it couldn't let go of is tried again, on the radios as
		// they are now.
		if (length(keys(held)))
			look_radios(at);
		let_go();
		advertise();
		if (sock) {
			sock.close();
			sock = null;
		}
		address = null;
		heard = {};
		nbrs = {};
		chosen = {};
		picks = {};
		rates = {};
		radios = {};   // and their survey counts, which would be stale when it is on again
		looked = false;
		return;
	}
	let a = management();
	if (a != address || !sock) {
		address = a;
		listen();
	}
	look_radios(at);
	advertise();
}

// survey reads a radio's survey of one frequency. For its own channel the
// counts run on; for another, both lab APs' drivers keep only the last
// visit's.
function survey(r, f) {
	for (let x in nl.request(nl.const.NL80211_CMD_GET_SURVEY, nl.const.NLM_F_DUMP, { dev: r.bss }) ?? [])
		if (x.survey_info?.frequency == f)
			return x.survey_info;
	return null;
}

// load reads how busy a radio's own channel has been since it was last
// read: all told, for whether to visit elsewhere now; and with this AP's
// own sending taken out, where the driver says what that was, for the
// channel's rating. Null the first time.
function load(r) {
	let s = survey(r, rrm.freq(r.band, r.channel));
	let was = r.survey;
	// A survey without a busy count says nothing of how busy the channel is.
	r.survey = s?.time && s.busy != null ? { time: s.time, busy: s.busy, tx: s.time_tx ?? 0 } : null;
	if (!was || !r.survey || r.survey.time <= was.time)
		return null;
	// The counts are whole numbers, which ucode divides to a whole number.
	let t = 1.0 * (r.survey.time - was.time), b = r.survey.busy - was.busy;
	return { all: b / t, others: (b - (r.survey.tx - was.tx)) / t, noise: s.noise };
}

// visit listens on a radio's next channel. Off its own, it goes only while
// its channel isn't busy, or once it put that off PUT_OFF times. It only
// listens: without a probe, a visit stays long enough to hear a beacon.
function visit(r, at) {
	if (!length(r.list))
		return;
	let l = load(r);
	// Interference: others kept its own channel busy, read after read.
	if (l) {
		r.hot_n = l.others > rrm.SUDDEN ? (r.hot_n ?? 0) + 1 : 0;
		r.hot_sum = r.hot_n ? (r.hot_sum ?? 0) + l.others : 0;
		r.hot = r.hot_n >= HOT ? r.hot_sum / r.hot_n : null;
	}
	let f = r.list[r.next % length(r.list)];
	let own = rrm.freq(r.band, r.channel);
	if (f != own && l && l.all > BUSY && r.put_off < PUT_OFF) {
		r.put_off++;
		f = own;
	} else {
		r.next++;
		r.put_off = 0;
	}
	nl.request(nl.const.NL80211_CMD_TRIGGER_SCAN, 0, { dev: r.bss, scan_frequencies: [ f ], scan_flags: SCAN_FLAG_AP });
	let err = nl.error();
	if (err) {
		// Once, a scan already running or the radio restarting: the next visit
		// tries again. Visit after visit, the radio doesn't scan at all. On a
		// channel shared with radar (DFS), Linux keeps an AP there listening
		// for radar and refuses every scan (2026-10-06, the office AP on 108):
		// its ratings on that band age until it leaves.
		r.refused = (r.refused ?? 0) + 1;
		if (r.refused >= DEAF_AFTER && !r.deaf) {
			r.deaf = { why: rrm.radar(r.band, r.channel) ? 'dfs' : 'refused', since: at };
			if (r.deaf.why == 'dfs')
				note('%s: on DFS channel %d the radio cannot scan, as it must keep listening for radar; its %s ratings age until it leaves', r.bss, r.channel, r.band);
			else
				note('%s: the radio refuses every scan (%s); its %s ratings age until it scans again', r.bss, err, r.band);
		}
		return;
	}
	if (r.deaf)
		log('%s: the radio scans again, on channel %d', r.bss, r.channel);
	r.refused = 0;
	r.deaf = null;
	r.scan = { freq: f, started: at, load: f == own ? l : null };
}

// channel is a frequency's channel number, as a whole number: the report
// says so.
function channel(band, f) {
	if (band == '2g')
		return f == 2484 ? 14 : int((f - 2407) / 5);
	return int((f - (band == '5g' ? 5000 : 5950)) / 5);
}

// rate folds a visit into its channel's ratings. On its own channel, how
// busy others kept it comes from the survey's counts since the last visit;
// elsewhere, from the visit's own.
function rate(r, sc, networks, at) {
	let busy = null, noise = null;
	if (sc.load) {
		busy = sc.load.others;
		noise = sc.load.noise;
	} else {
		let s = survey(r, sc.freq);
		if (s?.time && s.busy != null) {
			// Less its own sending: on its own channel, at the first visit, the
			// counts run from the radio's start. Elsewhere there is none.
			busy = (s.busy - (s.time_tx ?? 0)) / (1.0 * s.time);
			noise = s.noise;
		}
	}
	if (busy == null)
		return;   // the driver said nothing of the visit
	busy = min(1, max(0, busy));
	// A driver may give 0 for a noise floor it didn't measure, as the R7800's
	// does on its own 5 GHz channel.
	if (!(type(noise) in ['int', 'double']) || noise < -127 || noise > -20)
		noise = null;
	let ch = channel(r.band, sc.freq);
	let c = rrm.cost(busy, noise, networks);
	let rt = rates[r.band + ' ' + ch] ??= { band: r.band, channel: ch, visits: 0 };
	rt.cost = rrm.blend(rt.cost, c, rrm.LASTING);
	rt.now = rrm.blend(rt.now, c, rrm.NOW);
	rt.busy = busy;
	rt.noise = noise;
	rt.networks = length(networks);
	rt.visits++;
	rt.at = at;
}

// printable is an SSID as the manager takes it: printable ASCII, anything
// else a ?, at most 32 bytes; null for a hidden network, whose SSID is
// empty or all zero bytes. An SSID of question marks is one, not hidden.
function printable(d) {
	let s = '', hidden = true;
	for (let i = 0; i < length(d ?? '') && i < 32; i++) {
		let c = ord(d, i);
		if (c != 0)
			hidden = false;
		s += c >= 32 && c < 127 ? chr(c) : '?';
	}
	return hidden ? null : s;
}

// channel_of is a frequency's channel, as Linux numbers it: 6 GHz's
// channel 2 sits below its channel 1, and 4.9 GHz counts from 4 GHz.
function channel_of(f) {
	if (f == 2484)
		return 14;
	if (f < 2484)
		return int((f - 2407) / 5);
	if (f >= 4910 && f <= 4980)
		return int((f - 4000) / 5);
	if (f < 5925)
		return int((f - 5000) / 5);
	if (f == 5935)
		return 2;
	return int((f - 5950) / 5);
}

// other keeps a network heard that carries no Aeolus advert (0105): its
// BSSID, SSID, band, channel and signal, for an hour, so the manager can
// tell one that takes the SSID of one of Aeolus's networks.
function other(b, band, at) {
	if (!match(b.bssid ?? '', /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
		return;
	let ssid = null;
	for (let e in b.beacon_ies ?? [])
		if (e.type == 0) {
			ssid = printable(e.data);
			break;
		}
	// What the manager would refuse, it never hears: one network it can't
	// take would cost the AP its whole report.
	let channel = channel_of(b.frequency), signal = dbm(b.signal_mbm / 100);
	if (ssid && channel >= 1 && channel <= 233 && signal != null)
		others[b.bssid] = { ssid: ssid, band: band, channel: channel, signal: signal, at: at };
}

// aeolus_radio says whether a BSSID is another of the networks of a radio
// whose advert was heard: a radio makes its BSSIDs from one MAC, changing
// only the first byte (30:86:2d:03:17:d0, 32:86:..., 36:86:..., C-360,
// 2026-10-10), and only one of them carries the advert.
function aeolus_radio(bssid, at) {
	let seen = aeolus_bss[substr(bssid, 3)];
	return seen != null && at - seen <= OTHERS_FOR;
}

// others_listed is the networks heard in the last hour, the strongest
// first; older ones are forgotten.
function others_listed(at) {
	let out = [], old = [];
	for (let bssid, o in others) {
		if (at - o.at > OTHERS_FOR) {
			push(old, bssid);
			continue;
		}
		if (aeolus_radio(bssid, at))
			continue;
		push(out, { bssid: bssid, ssid: o.ssid, band: o.band, channel: o.channel, signal: o.signal, ago: max(0, int(at - o.at)) });
	}
	for (let bssid in old)
		delete others[bssid];
	for (let k in keys(aeolus_bss))
		if (at - aeolus_bss[k] > OTHERS_FOR)
			delete aeolus_bss[k];
	return slice(sort(out, (x, y) => y.signal - x.signal), 0, OTHERS_MAX);
}

// heard_on reads what a visit heard: other Aeolus APs' adverts, and the
// other networks there, which go into the channel's rating. On 2.4 GHz, a
// network up to three channels away counts too, 6 dB weaker for each
// channel between.
function heard_on(r, at) {
	let sc = r.scan;
	r.scan = null;
	let within = (at - sc.started) * 1000 + 500;
	let networks = [];
	for (let x in nl.request(nl.const.NL80211_CMD_GET_SCAN, nl.const.NLM_F_DUMP, { dev: r.bss }) ?? []) {
		let b = x.bss;
		if (!b?.frequency || (b.seen_ms_ago ?? within + 1) > within)
			continue;
		let d = b.frequency - sc.freq;
		if (d < 0)
			d = -d;
		if (d > (r.band == '2g' ? 15 : 0))
			continue;
		// Beacons only: both lab APs' drivers answer probes from a template
		// that misses the element's changes, without it once it is put on, or
		// with it once it is taken off.
		let a = null;
		for (let e in b.beacon_ies ?? []) {
			a = e.type == 221 ? rrm.read_advert(e.data) : null;
			if (a)
				break;
		}
		if (!a) {
			push(networks, b.signal_mbm / 100 - 6 * d / 5);
			if (!d)
				other(b, r.band, at);
			continue;
		}
		if (match(b.bssid ?? '', /^[0-9a-f]{2}(:[0-9a-f]{2}){5}$/))
			aeolus_bss[substr(b.bssid, 3)] = at;
		if (a.ap == cfg.ap || d)
			continue;
		let h = heard[a.ap] ??= { bands: {} };
		h.address = a.address;
		h.port = a.port;
		let hb = h.bands[rrm.band_of(b.frequency)] ??= {};
		hb.signal = rrm.smooth(hb.signal, b.signal_mbm / 100);
		hb.at = at;
	}
	rate(r, sc, networks, at);
}

// signals are how strongly each AP is heard now, by band.
function signals(at) {
	let out = {};
	for (let ap, h in heard)
		for (let band, hb in h.bands)
			if (at - hb.at <= HEARD_FOR)
				(out[ap] ??= {})[band] = hb.signal;
	return out;
}

// state is a neighbour's: up when hellos go both ways, one-way when its
// come but don't list this AP, down when they stopped, and heard when it is
// only heard in the air.
function state(n, at) {
	if (n?.at == null)
		return 'heard';
	if (at - n.at > rrm.DEAD)
		return 'down';
	return index(n.msg?.sees ?? [], cfg.ap) >= 0 ? 'up' : 'one-way';
}

// hellos sends this round's hello to each neighbour: the three heard most
// strongly on each band, or as many as power control looks for where that
// is more (0077), and those whose hellos come.
function hellos(at) {
	let sig = signals(at);
	chosen = {};
	picks = rrm.choose(sig, rrm.NEIGHBOURS);
	for (let band, list in picks)
		for (let ap in list)
			chosen[ap] = true;
	let to = {};
	for (let ap in keys(chosen))
		to[ap] = true;
	// Power control needs how each neighbour it looks for hears this AP,
	// which comes in their hellos; those come back once this AP sends.
	if (cfg.apc && cfg.wanted > rrm.NEIGHBOURS)
		for (let band, list in rrm.choose(sig, cfg.wanted))
			for (let ap in list)
				to[ap] = true;
	for (let ap, n in nbrs)
		if (n.at != null && at - n.at <= rrm.DEAD)
			to[ap] = true;
	if (!sock || !length(keys(to)))
		return;
	let mine = [];
	for (let ap, bands in sig)
		for (let band, s in bands)
			if (dbm(s) != null)
				push(mine, { ap: ap, band: band, signal: dbm(s) });
	let msg = {
		v: 1, t: 'hello', ap: cfg.ap, at: time(), seq: ++seq,
		// A radio's claim: where it is about to move, and its own channel's
		// rating, for the tie-break.
		radios: map(values(radios), r => r.claim
			? { band: r.band, channel: r.channel, width: r.width, to: r.claim.to, cost: r.claim.cost }
			: { band: r.band, channel: r.channel, width: r.width }),
		heard: slice(sort(mine, (a, b) => b.signal - a.signal), 0, 24),
		sees: filter(keys(nbrs), ap => nbrs[ap].at != null && at - nbrs[ap].at <= rrm.DEAD),
	};
	let pkt = rrm.seal(cfg.key, msg);
	for (let ap in keys(to)) {
		// Where its signed hellos come from, while they come: an address
		// heard in the air may be an old one.
		let n = nbrs[ap];
		let where = n?.at != null && at - n.at <= rrm.DEAD ? n : heard[ap] ?? n;
		if (where?.address)
			sock.send(pkt, 0, { address: where.address, port: where.port ?? rrm.PORT });
	}
}

// receive reads the hellos waiting: signed with the key, from another AP,
// and newer than its last.
function receive(at) {
	let from = {}, pkt;
	while ((pkt = sock.recv(2048, socket.MSG_DONTWAIT, from)) != null) {
		let m = rrm.open(cfg.key, pkt);
		if (!m || m.t != 'hello' || m.ap == cfg.ap)
			continue;
		let n = nbrs[m.ap] ??= {};
		if (!rrm.fresh(n.last, m, time()))
			continue;
		n.last = { at: m.at, seq: m.seq };
		n.address = from.address;
		n.port = from.port;
		n.at = at;
		n.msg = m;
		from = {};
	}
}

// changes logs neighbours coming up and going down, and forgets those down
// long enough, and APs no longer heard in the air.
function changes(at) {
	for (let ap in keys(heard)) {
		let h = heard[ap];
		for (let b in keys(h.bands))
			if (at - h.bands[b].at > HEARD_FOR)
				delete h.bands[b];
		if (!length(h.bands))
			delete heard[ap];
	}
	for (let ap, n in nbrs) {
		let s = state(n, at);
		if (s != n.state) {
			if (s == 'up' || n.state == 'up')
				log('neighbour %s at %s: %s, was %s', ap, n.address, s, n.state ?? 'new');
			n.state = s;
		}
		if (s == 'down' && at - n.at > FORGET)
			delete nbrs[ap];
	}
}

// listing is what the agent reports of another AP: on each band, how
// strongly each hears the other, and its channel and width, as its hellos
// say. What a neighbour says is checked, so a bad one can't spoil the
// report.
function listing(ap, at) {
	let h = heard[ap], n = nbrs[ap], m = n?.msg;
	let bands = {};
	let band = (b) => bands[b] ??= { band: b, signal: null, their_signal: null, channel: null, width: null };
	for (let b, hb in h?.bands ?? {})
		if (at - hb.at <= HEARD_FOR)
			band(b).signal = dbm(hb.signal);
	if (state(n, at) in ['up', 'one-way']) {
		for (let x in (type(m.heard) == 'array' ? m.heard : []))
			if (x?.ap == cfg.ap && x.band in ['2g', '5g', '6g'])
				band(x.band).their_signal = dbm(x.signal);
		for (let x in (type(m.radios) == 'array' ? m.radios : []))
			if (x?.band in ['2g', '5g', '6g']) {
				band(x.band).channel = type(x.channel) == 'int' && x.channel >= 0 && x.channel <= 233 ? x.channel : null;
				band(x.band).width = x.width in [20, 40, 80, 160, 320] ? x.width : null;
			}
	}
	return {
		ap: ap, address: h?.address ?? n?.address ?? '', state: state(n, at), chosen: !!chosen[ap],
		hello_ago: n?.at != null ? int(at - n.at) : null,
		bands: slice(sort(values(bands), (a, b) => a.band < b.band ? -1 : 1), 0, 3),
	};
}

// near is, on each band, the neighbours that count there: those among the
// three this AP hears best there, and those whose hellos say they hear it
// there.
function near(at) {
	let out = {};
	for (let band, list in picks)
		for (let ap in list)
			(out[band] ??= {})[ap] = true;
	for (let ap, n in nbrs)
		if (state(n, at) in ['up', 'one-way'])
			for (let x in (type(n.msg.heard) == 'array' ? n.msg.heard : []))
				if (x?.ap == cfg.ap && x.band in ['2g', '5g', '6g'])
					(out[x.band] ??= {})[ap] = true;
	return out;
}

// blotted is, by '<band> <channel>', the neighbours that count on the band
// using each channel, or claiming it for a move. Their channels, claims and
// widths are their hellos'.
function blotted(at) {
	let out = {};
	for (let band, aps in near(at))
		for (let ap in keys(aps)) {
			let n = nbrs[ap];
			if (!(state(n, at) in ['up', 'one-way']))
				continue;
			for (let x in (type(n.msg.radios) == 'array' ? n.msg.radios : []))
				if (x?.band == band)
					for (let ch in [x.channel, x.to])
						if (type(ch) == 'int' && ch > 0 && ch <= 233)
							for (let c in rrm.covers(band, ch, x.width))
								push(out[band + ' ' + c] ??= [], ap);
		}
	return out;
}

// claims are the moves the neighbours that count on a band have claimed
// there: { ap, to, cost }.
function claims(at, band) {
	let out = [];
	for (let ap in keys(near(at)[band] ?? {})) {
		let n = nbrs[ap];
		if (!(state(n, at) in ['up', 'one-way']))
			continue;
		for (let x in (type(n.msg.radios) == 'array' ? n.msg.radios : []))
			if (x?.band == band && type(x.to) == 'int' && x.to > 0 && x.to <= 233)
				push(out, { ap: ap, to: x.to, cost: type(x.cost) == 'int' ? x.cost : 0 });
	}
	return out;
}

// close is, on a band, how near each neighbour is by signal: the stronger
// of how this AP hears it and how its hellos say it hears this AP.
function close(band) {
	let out = {};
	for (let ap, h in heard)
		if (h.bands[band]?.signal != null)
			out[ap] = h.bands[band].signal;
	for (let ap, n in nbrs)
		for (let x in (type(n.msg?.heard) == 'array' ? n.msg.heard : []))
			if (x?.ap == cfg.ap && x.band == band && dbm(x.signal) != null)
				out[ap] = max(out[ap] ?? -200, dbm(x.signal));
	return out;
}

// targets are the blocks a radio may move to, from its band's ratings: at
// its width, wholly in its set where it has one (0075), and none shared with
// radar, as a move there would first have to listen for radar, off the air.
function targets(r, list) {
	return filter(rrm.blocks(list, r.band, r.width), x =>
		!length(filter(x.members, c => rrm.radar(r.band, c) || (r.allowed && index(r.allowed, c) < 0))));
}

// table is the channels rated, as the agent reports them, with whether one
// of this AP's radios is on each, who blots it out, and which is the best on
// each band: where its radio would move (rrm.best_of).
function table(at) {
	let blot = blotted(at), list = [];
	for (let k in keys(rates)) {
		let rt = rates[k];
		if (at - rt.at > RATED_FOR) {
			delete rates[k];
			continue;
		}
		let own = false;
		for (let name, r in radios)
			if (r.band == rt.band && index(rrm.covers(r.band, r.channel, r.width), rt.channel) >= 0)
				own = true;
		push(list, {
			band: rt.band, channel: rt.channel, cost: int(rt.cost + 0.5), now: int(rt.now + 0.5),
			busy: int(rt.busy * 100 + 0.5), noise: dbm(rt.noise), networks: rt.networks, visits: rt.visits,
			ago: int(at - rt.at), own: own, blotted_by: slice(uniq(sort(blot[k] ?? [])), 0, 8), best: false,
		});
	}
	for (let name, r in radios) {
		let these = filter(list, x => x.band == r.band);
		let b = rrm.best_of(targets(r, these), close(r.band));
		for (let x in these)
			x.best = x.channel == b?.channel;
	}
	return list;
}

// complete says whether every channel a radio visits has been rated: until
// then it doesn't know where it could go.
function complete(r) {
	for (let f in r.list)
		if (!rates[r.band + ' ' + channel(r.band, f)])
			return false;
	return true;
}

// cooling says whether a radio on band moved, or failed to, within COOL.
function cooling(band) {
	let wall = time();
	for (let m in moves)
		if (m.band == band && m.state in ['moved', 'failed'] && wall - m.at < COOL)
			return true;
	return false;
}

// claim announces a radio's move in its hellos.
function claim(r, at, to, why, cost, start) {
	let m = { band: r.band, from: r.channel, to: to, why: why, state: 'announced', at: time() };
	record(m);
	r.claim = { to: to, cost: int(cost + 0.5), start: start, since: at, move: m };
	log('%s: claims channel %d, to move from %d (%s)', r.band, to, r.channel, why);
}

// switch_to moves a radio to channel to, by hostapd's channel switch
// announcement on one of its networks, which moves them all.
function switch_to(r, to) {
	let args = rrm.switch_args(r.band, to, r.width, r.mode, ANNOUNCE);
	let err = 'its width does not fit there';
	if (args) {
		bus.call(`hostapd.${r.bss}`, 'switch_chan', args);
		err = bus.error();
	}
	if (err) {
		note('%s: cannot move from channel %d to %d: %s', r.band, r.channel, to, err);
		end_claim(r, 'failed');
		return;
	}
	end_claim(r, 'moved');
	r.channel = to;
	r.list = rrm.visits(r.band, to, r.dfs);
	calm(r);
}

// decide moves the radios that should (0073). A move is claimed in hellos
// first, and made HOLD later, unless a neighbour's claim at the same time
// goes first, or it is no longer worth it. Planned moves wait for their
// reason to hold STEADY, and for the window.
function decide(at, list) {
	let lt = localtime(), windowed = rrm.in_window(cfg.window, lt.hour * 60 + lt.min);
	for (let name, r in radios) {
		let others = claims(at, r.band);
		if (length(others))
			claimed[r.band] = at;
		if (!cfg.moves || r.pinned) {
			if (r.claim)
				end_claim(r, 'withdrawn');
			r.plan = null;
			continue;
		}
		let cl = close(r.band), these = filter(list, x => x.band == r.band);
		let cur = filter(rrm.blocks(these, r.band, r.width), x => index(x.members, r.channel) >= 0)[0];
		let to = targets(r, these);
		let c = r.claim;
		if (c) {
			// Two claims at once: the tie-break says which goes first.
			for (let o in others)
				if (!rrm.first({ ap: cfg.ap, cost: c.cost }, o)) {
					end_claim(r, 'yielded', o.ap);
					break;
				}
			if (!r.claim || at - c.since < HOLD)
				continue;
			let t = filter(to, x => x.channel == c.to)[0];
			if (rrm.reason(cur, t, cl, cfg.margin, r.hot, c.start))
				switch_to(r, c.to);
			else
				end_claim(r, 'withdrawn');
			continue;
		}
		if (at - began < WARM_UP || !cur || !complete(r)) {
			r.plan = null;
			continue;
		}
		let start = r.started != null && at - r.started < START;
		let best = rrm.best_of(to, cl);
		let why = rrm.reason(cur, best, cl, cfg.margin, r.hot, start);
		if (!why) {
			r.plan = null;
			continue;
		}
		// The wait is for this move: another target, or another reason,
		// starts it again.
		let plan = why + ' ' + best.channel;
		if (r.plan?.move != plan)
			r.plan = { move: plan, since: at };
		if (why in ['shared', 'better'] && !start && (at - r.plan.since < STEADY || !windowed))
			continue;
		// One move at a time among neighbours: none while one of theirs is
		// claimed, or just after.
		if (cooling(r.band) || length(others) || at - (claimed[r.band] ?? -SETTLE) < SETTLE)
			continue;
		claim(r, at, best.channel, why, cur.cost, start);
	}
}

// heard_by is how strongly the neighbours whose hellos come hear this AP on
// band, in dBm, as their hellos say.
function heard_by(band, at) {
	let out = [];
	for (let ap, n in nbrs)
		if (state(n, at) in ['up', 'one-way'])
			for (let x in (type(n.msg.heard) == 'array' ? n.msg.heard : []))
				if (x?.ap == cfg.ap && x.band == band && dbm(x.signal) != null) {
					push(out, dbm(x.signal));
					break;
				}
	return out;
}

// ceiling lets a radio's power go back to what it is configured to, and
// reads it: the most power control holds it at. It is what the radio says,
// which may be more than it can send (0077).
function ceiling(r) {
	if (!set_power(r.phy, null))
		return null;
	let p = bus.call('iwinfo', 'info', { device: r.bss })?.txpower;
	return type(p) == 'int' && p > 0 && p <= 40 ? p : null;
}

// apc holds each radio's power where the neighbours it looks for hear it at
// the target (0077). It takes a radio over after the warm-up, at the power
// the last run held it at, or its ceiling; holds it again whenever its
// network is made anew, as netifd puts its power back then; and steps it at
// most every APC_EVERY. A radio whose power is set, or that shares its
// wiphy with another, it leaves alone; off, it lets them all go.
function apc(at) {
	if (!cfg.apc)
		let_go();
	if (!cfg.apc || at - began < WARM_UP)
		return;
	let phys = {};
	for (let name, r in radios)
		if (r.phy)
			phys[r.phy] = (phys[r.phy] ?? 0) + 1;
	for (let name, r in radios) {
		let h = held[name];
		if (h && h.band != r.band)
			h = held[name] = null;
		if (!r.phy || phys[r.phy] != 1 || r.power_set) {
			if (h?.power != null && !r.power_set && r.phy == h.phy && r.index == h.index)
				set_power(h.phy, null);
			delete held[name];
			continue;
		}
		if (!h || h.index != r.index || (h.power == null && at - h.at >= APC_EVERY)) {
			let top = ceiling(r);
			let was = h?.power ?? (kept[name]?.band == r.band ? kept[name].power : null);
			delete kept[name];
			// Held again after its network was made anew, it keeps its last step.
			let again = h?.power != null;
			h = held[name] = {
				band: r.band, phy: r.phy, index: r.index, power: null, ceiling: top, at: again ? h.at : at,
				step: again ? h.step : 0, why: again ? h.why : 'new', count: h?.count, weakest: h?.weakest, stepped: h?.stepped,
			};
			if (top == null) {
				h.why = 'failed';
				note('%s: power control cannot read the radio\'s power', r.band);
				continue;
			}
			let p = max(min(type(was) == 'int' ? was : top, top), min(rrm.APC_FLOOR, top));
			if (!set_power(r.phy, p)) {
				h.why = 'failed';
				note('%s: power control cannot set the radio\'s power', r.band);
				continue;
			}
			h.power = p;
			log('%s: power control holds it at %d dBm, of %d', r.band, p, top);
			continue;
		}
		if (h.power == null || at - h.at < APC_EVERY)
			continue;
		let s = rrm.power_step(heard_by(r.band, at), cfg.wanted, cfg.target, h.power, h.ceiling);
		h.at = at;
		h.count = s.count;
		h.weakest = s.weakest;
		h.why = s.why;
		h.step = 0;
		if (!s.step)
			continue;
		if (!set_power(r.phy, h.power + s.step)) {
			note('%s: power control cannot set the radio\'s power', r.band);
			continue;
		}
		h.power += s.step;
		h.step = s.step;
		h.stepped = time();
		log('%s: power %s%d dB to %d dBm: %d of %d neighbours hear it, the weakest at %s', r.band, s.step > 0 ? '+' : '', s.step, h.power,
			s.count, cfg.wanted, s.weakest ?? 'none');
	}
	// A radio that went down keeps what it was held at for when it is back.
}

// powers is what the agent reports of power control (0077): each radio it
// holds, its power and ceiling, how many of the neighbours it looks for
// hear it and the weakest of them, and its last step and why.
function powers() {
	let out = [];
	for (let name in sort(keys(held))) {
		let h = held[name];
		if (!radios[name])
			continue;
		push(out, {
			radio: name, band: h.band, power: h.power, ceiling: h.ceiling, wanted: cfg.wanted, target: cfg.target,
			count: h.count, weakest: h.weakest, step: h.step, why: h.why,
			ago: h.stepped != null ? max(0, time() - h.stepped) : null,
		});
	}
	return slice(out, 0, 4);
}

function write(at) {
	if (!cfg.on) {
		store(out, sprintf('%J', { at: time(), on: false }));
		return;
	}
	let aps = {};
	for (let ap, h in heard)
		for (let b, hb in h.bands)
			if (at - hb.at <= HEARD_FOR)
				aps[ap] = true;
	for (let ap in keys(nbrs))
		aps[ap] = true;
	let list = map(keys(aps), ap => listing(ap, at));
	list = sort(list, (a, b) => (b.chosen - a.chosen) || (a.ap < b.ap ? -1 : 1));
	let advertised = [];
	for (let name, r in radios)
		if (adverts[r.bss])
			push(advertised, r.band);
	let rated = sort(table(at), (a, b) => a.band < b.band ? -1 : a.band > b.band ? 1 : a.channel - b.channel);
	// The radios that can't scan: their band, channel, why (dfs or
	// refused) and for how long. One whose channel isn't known just now, as
	// while its Wi-Fi restarts or it waits out a radar check, is left out
	// until it is: the manager refuses a whole report over a channel 0
	// (OfficeOpenWrt, 2026-10-10, after a Wi-Fi change).
	let deaf = [];
	for (let name, r in radios)
		if (r.deaf && r.channel >= 1 && r.channel <= 233)
			push(deaf, { band: r.band, channel: r.channel, why: r.deaf.why, ago: max(0, int(at - r.deaf.since)) });
	store(out, sprintf('%J', {
		at: time(), on: true, address: address ?? '', advertised: slice(uniq(sort(advertised)), 0, 3),
		neighbours: slice(list, 0, LISTED), ratings: slice(rated, 0, RATED), moves: moves, apc: powers(),
		cannot_scan: deaf, others: others_listed(at),
	}));
}

// restore reads back what the daemon's last run found, as when the agent
// was updated: the ratings the channels earned, the moves made, so a radio
// that just moved stays put, and the power each radio was held at (0077).
// A move it had claimed is withdrawn.
function restore(at) {
	let r = null;
	try {
		r = json(read(out) ?? 'null');
	} catch (e) {
	}
	if (r?.on != true || type(r.at) != 'int')
		return;
	let wall = time();
	for (let x in (type(r.ratings) == 'array' ? r.ratings : [])) {
		if (!(x?.band in ['2g', '5g', '6g']) || type(x.channel) != 'int' || type(x.ago) != 'int' ||
		    !(type(x.cost) in ['int', 'double']) || !(type(x.now) in ['int', 'double']))
			continue;
		let ago = wall - r.at + x.ago;
		if (ago < 0 || ago > RATED_FOR)
			continue;
		rates[x.band + ' ' + x.channel] = {
			band: x.band, channel: x.channel, cost: x.cost, now: x.now, busy: (x.busy ?? 0) / 100.0,
			noise: x.noise, networks: x.networks ?? 0, visits: x.visits ?? 1, at: at - ago,
		};
	}
	for (let m in (type(r.moves) == 'array' ? r.moves : []))
		if (m?.band in ['2g', '5g', '6g'] && type(m.from) == 'int' && type(m.to) == 'int' && type(m.at) == 'int' &&
		    m.why in WHYS && m.state in STATES) {
			if (m.state == 'announced') {
				m.state = 'withdrawn';
				m.at = wall;
			}
			record(m);
		}
	for (let x in (type(r.apc) == 'array' ? r.apc : []))
		if (type(x?.radio) == 'string' && x.band in ['2g', '5g', '6g'] && type(x.power) == 'int' && x.power > 0 && x.power <= 40)
			kept[x.radio] = { band: x.band, power: x.power };
}

// stop takes the element off the beacons, so no AP keeps taking this one
// for a neighbour after it stops. The power control holds, it keeps, for the
// next run: netifd puts it back when a radio starts again.
function stop() {
	cfg = { on: false };
	advertise();
	exit(0);
}

function main() {
	signal('SIGTERM', stop);
	signal('SIGINT', stop);
	fs.mkdir('/var/run/aeolus');
	began = now();
	restore(began);
	let next_look = 0, next_hello = 0, next_write = 0;
	// The agent sends a SIGHUP when it has applied a config, so a change is
	// taken up at once.
	signal('SIGHUP', () => { next_look = 0; });
	while (true) {
		let at = now();
		if (at >= next_look) {
			look(at);
			next_look = at + LOOK_EVERY;
		}
		if (cfg.on) {
			for (let name, r in radios)
				if (r.scan && at >= r.scan.started + VISIT_WAIT)
					heard_on(r, at);
				else if (!r.scan && at >= r.due) {
					visit(r, at);
					r.due = at + VISIT_EVERY;
				}
			// A claim goes out in the hello that follows it.
			if (at >= next_hello) {
				changes(at);
				decide(at, table(at));
				apc(at);
				hellos(at);
				next_hello = at + rrm.HELLO_EVERY;
			}
		}
		if (at >= next_write) {
			write(at);
			next_write = at + WRITE_EVERY;
		}
		let due = min(next_look, next_write);
		if (cfg.on) {
			due = min(due, next_hello);
			for (let name, r in radios)
				due = min(due, r.scan ? r.scan.started + VISIT_WAIT : r.due);
		}
		let wait = max(10, min(1000, int((due - now()) * 1000)));
		if (!sock) {
			sleep(wait);
			continue;
		}
		for (let x in socket.poll(wait, [sock, socket.POLLIN]) ?? [])
			if (x[1] & (socket.POLLIN | socket.POLLERR))
				receive(now());
	}
}

main();

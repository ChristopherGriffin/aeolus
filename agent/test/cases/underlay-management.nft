# Made by the Aeolus agent from its VXLAN tunnels (0054); fw4 loads it.
table bridge aeolus
delete table bridge aeolus
table bridge aeolus {
	chain forward {
		type filter hook forward priority filter; policy accept;
		meta ibrname "br-vx50" ether type ip tcp flags & (syn | rst) == syn tcp option maxseg size > 1410 tcp option maxseg size set 1410
		meta ibrname "br-vx50" ether type ip6 tcp flags & (syn | rst) == syn tcp option maxseg size > 1390 tcp option maxseg size set 1390
	}
}

package wireless

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'soc/1b500000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '5g'
	option channel '36'
	option htmode 'VHT160'
	option disabled '0'
	option ucentral_path '/radios/1'
	option txantenna '15'
	option rxantenna '15'
	option noscan '1'
	option country 'US'
	option legacy_rates '0'
	option maxassoc_ignore_probe '0'
	option reconf '1'
	option acs_exclude_dfs '0'
	option txpower '20'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'soc/1b700000.pcie/pci0001:00/0001:00:00.0/0001:01:00.0'
	option band '2g'
	option channel '11'
	option htmode 'HT20'
	option disabled '0'
	option ucentral_path '/radios/0'
	option txantenna '15'
	option rxantenna '15'
	option noscan '1'
	option country 'US'
	option legacy_rates '0'
	option maxassoc_ignore_probe '0'
	option reconf '1'
	option acs_exclude_dfs '0'

config wifi-iface 'iot24'
	option device 'radio1'
	option network 'iot'
	option mode 'ap'
	option ssid 'Sweet_Spot_IoT'
	option encryption 'psk2'
	option key 'fixture-key-iot24'

config wifi-iface 'trusted_radio0'
	option device 'radio0'
	option network 'trusted'
	option mode 'ap'
	option ssid 'Sweet Spot'
	option encryption 'psk2'
	option key 'fixture-key-trusted_radio0'
	option ieee80211r '1'
	option ft_over_ds '0'
	option ft_psk_generate_local '1'

config wifi-iface 'trusted_radio1'
	option device 'radio1'
	option network 'trusted'
	option mode 'ap'
	option ssid 'Sweet Spot'
	option encryption 'psk2'
	option key 'fixture-key-trusted_radio1'
	option ieee80211r '1'
	option ft_over_ds '0'
	option ft_psk_generate_local '1'

config wifi-iface 'aeolus_iot_lab_radio1'
	option device 'radio1'
	option mode 'ap'
	option network 'aeolus_iot_lab'
	option ssid 'IoT Lab'
	option encryption 'psk2'
	option key 'fixture-passphrase-3'
	option hidden '1'
	option isolate '1'
	option ieee80211k '1'
	option bss_transition '1'
	option multicast_to_unicast '0'

config wifi-iface 'aeolus_sweet_lab_radio0'
	option device 'radio0'
	option mode 'ap'
	option network 'aeolus_sweet_lab'
	option ssid 'Sweet Lab'
	option encryption 'sae-mixed'
	option key 'fixture-passphrase-2'
	option ieee80211r '1'
	option ft_over_ds '0'
	option ft_psk_generate_local '1'
	option ieee80211k '1'
	option bss_transition '1'
	option multicast_to_unicast '1'

config wifi-iface 'aeolus_sweet_lab_radio1'
	option device 'radio1'
	option mode 'ap'
	option network 'aeolus_sweet_lab'
	option ssid 'Sweet Lab'
	option encryption 'sae-mixed'
	option key 'fixture-passphrase-2'
	option ieee80211r '1'
	option ft_over_ds '0'
	option ft_psk_generate_local '1'
	option ieee80211k '1'
	option bss_transition '1'
	option multicast_to_unicast '1'

package network

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option ifname 'lo'
	option netmask '255.0.0.0'

config globals 'globals'
	option dhcp_default_duid '0004fixture'
	option ula_prefix 'fd59:2068:3844::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'wan'
	option ipv6 '0'

config interface 'lan'
	option device 'br-lan.1'
	option proto 'dhcp'
	option multipath 'off'

config bridge-vlan 'vlan1'
	option device 'br-lan'
	option vlan '1'
	list ports 'wan:u*'
	list ports 'lan1:u*'
	list ports 'lan2:u*'
	list ports 'lan3:u*'
	list ports 'lan4:u*'

config bridge-vlan 'vlan10'
	option device 'br-lan'
	option vlan '10'
	list ports 'wan:t'

config interface 'iot'
	option proto 'none'
	option device 'br-lan.10'

config bridge-vlan 'vlan20'
	option device 'br-lan'
	option vlan '20'
	list ports 'wan:t'

config interface 'trusted'
	option proto 'none'
	option device 'br-lan.20'

config interface 'aeolus_iot_lab'
	option proto 'none'
	option device 'br-lan.10'

config bridge-vlan 'aeolus_vlan30'
	option device 'br-lan'
	option vlan '30'
	list ports 'wan:t'

config interface 'aeolus_sweet_lab'
	option proto 'none'
	option device 'br-lan.30'

package system

config system
	option hostname 'OpenWrtnight'
	option timezone 'CST6CDT,M3.2.0,M11.1.0'
	option zonename 'America/Chicago'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option compat_version '1.1'
	option log_proto 'udp'
	option conloglevel '8'
	option cronloglevel '7'
	option log_ip '192.168.20.50'
	option log_port '514'

config timeserver 'ntp'
	list server 'time.symtus.com'
	list server '0.pool.ntp.org'

config led 'led_wan'
	option name 'WAN'
	option sysfs 'white:wan'
	option trigger 'netdev'
	option mode 'link tx rx'
	option dev 'wan'

package aeolus

config agent 'agent'
	option url 'https://aeolus.symtus.com:8443'
	option uplink 'wan'
	option poll '30'

package usteer

config usteer
	option network 'lan'
	option syslog '1'
	option local_mode '0'
	option ipv6 '0'
	option debug_level '2'
	option band_steering_interval '30000'
	list ssid_list 'IoT Lab'
	list ssid_list 'Sweet Lab'

package snmpd

config agent 'agent'
	option agentaddress 'UDP:161,UDP6:161'

config com2sec 'aeolus_v2c'
	option secname 'ro'
	option source 'default'
	option community 'fixture-community'

config com2sec6 'aeolus_v2c6'
	option secname 'ro'
	option source 'default'
	option community 'fixture-community'

config group 'aeolus_ro_v2c'
	option group 'ro'
	option version 'v2c'
	option secname 'ro'

config view 'all'
	option viewname 'all'
	option type 'included'
	option oid '.1'

config access 'aeolus_ro'
	option group 'ro'
	option context 'none'
	option version 'any'
	option level 'noauth'
	option prefix 'exact'
	option read 'all'
	option write 'none'
	option notify 'none'

config system 'system'
	option sysLocation 'Pumphouse'
	option sysContact 'ops@example.com'

config engineid 'engineid'
	option engineidtype '3'
	option engineidnic 'wan'

config v3 'aeolus_v3'
	option username 'monitor'
	option auth_type 'SHA'
	option auth_pass 'fixture-auth-1'
	option privacy_type 'AES'
	option privacy_pass 'fixture-privacy-1'
	option allow_write '0'

config snmpd 'general'
	option enabled '1'
	option snmp_version 'v1/v2c/v3'

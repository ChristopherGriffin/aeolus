{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChristopherGriffin/aeolus/internal/schema/v1.json",
  "title": "Aeolus AP config, v1",
  "description": "The fully resolved config an AP receives (0008). Every leaf is a field that can be set on a folder or an AP (0012). x-aeolus-tree says which tree owns each part (0013). writeOnly marks secrets (0027). readOnly parts are filled in by the manager, never set in a tree.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "radio": {
      "x-aeolus-tree": "locations",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "2g": { "$ref": "#/$defs/radio2g" },
        "5g": { "$ref": "#/$defs/radio5g" },
        "6g": { "$ref": "#/$defs/radio6g" }
      }
    },
    "system": {
      "x-aeolus-tree": "locations",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "Regulatory country, ISO 3166 alpha-2." },
        "tz": { "type": "string", "minLength": 1, "maxLength": 64, "description": "IANA time zone, e.g. America/Chicago." },
        "ntp": { "type": "array", "items": { "$ref": "#/$defs/host" }, "maxItems": 4 },
        "poll": { "type": "integer", "minimum": 10, "maximum": 3600, "description": "Seconds between config polls (0007)." },
        "syslog": { "$ref": "#/$defs/host", "description": "Remote syslog host, optionally host:port." },
        "ssh_keys": { "type": "array", "items": { "type": "string", "pattern": "^(ssh-ed25519|ecdsa-sha2-nistp256|ssh-rsa) [A-Za-z0-9+/=]+( .*)?$" } },
        "snmp": {
          "type": "object",
          "additionalProperties": false,
          "description": "Answering SNMP queries, read-only, through snmpd, which the agent's installer adds (0052).",
          "properties": {
            "enabled": { "type": "boolean", "default": false, "description": "Answer SNMP queries; unset, the AP does not." },
            "community": { "type": "string", "pattern": "^[A-Za-z0-9._~!@#%^*+=:-]{1,64}$", "writeOnly": true, "description": "The read-only SNMP v2c community." },
            "v3": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "user": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$", "description": "The read-only SNMP v3 user." },
                "auth": { "type": "string", "pattern": "^[^\"\\\\\\x00-\\x1f]{8,64}$", "writeOnly": true, "description": "The v3 user's authentication passphrase, used with SHA." },
                "privacy": { "type": "string", "pattern": "^[^\"\\\\\\x00-\\x1f]{8,64}$", "writeOnly": true, "description": "The v3 user's privacy passphrase, used with AES." }
              }
            },
            "location": { "type": "string", "pattern": "^[^\\x00-\\x1f]{0,128}$", "description": "sysLocation." },
            "contact": { "type": "string", "pattern": "^[^\\x00-\\x1f]{0,128}$", "description": "sysContact." }
          }
        },
        "management": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vlan": { "type": "integer", "minimum": 0, "maximum": 4094, "description": "0 means untagged." },
            "addressing": { "enum": ["dhcp", "static"] },
            "address": { "type": "string", "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$", "description": "CIDR, for static addressing." },
            "gateway": { "$ref": "#/$defs/ip" },
            "dns": { "type": "array", "items": { "$ref": "#/$defs/ip" }, "maxItems": 3 }
          },
          "allOf": [
            { "if": { "properties": { "addressing": { "const": "static" } }, "required": ["addressing"] }, "then": { "required": ["address", "gateway"] } }
          ]
        }
      }
    },
    "ports": {
      "x-aeolus-tree": "locations",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9._-]{0,15}$" },
      "additionalProperties": { "$ref": "#/$defs/port" }
    },
    "network": {
      "x-aeolus-tree": "services",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/networkId" },
      "additionalProperties": { "$ref": "#/$defs/network" }
    },
    "concentrators": {
      "x-aeolus-tree": "locations",
      "description": "Tunnels, by name: the far end a VXLAN transport reaches (0055). A network picks one by name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/concentrator" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "ipAddress": {
      "description": "An IPv4 or IPv6 address.",
      "type": "string",
      "maxLength": 45,
      "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*)$"
    },
    "ipv4Address": {
      "description": "An IPv4 address.",
      "type": "string",
      "maxLength": 15,
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
    },
    "probeAddress": {
      "$ref": "#/$defs/ipv4Address",
      "description": "An address on the segment for the AP to ask, by ARP, whether its traffic gets across: normally the segment's gateway (0059). Unset, the AP asks any IPv6 host there."
    },
    "networkId": {
      "description": "A network's name. It starts with a letter, and vlan<number>, port-<anything> and n followed by 8 hex digits, each alone or followed by a hyphen and more, are kept for the names Aeolus gives its own sections on an AP (0054, 0061, 0063).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "not": { "pattern": "^(vlan[0-9]+($|-)|port-|n[0-9a-f]{8}($|-))" }
    },
    "vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
    "ip": { "type": "string", "pattern": "^[0-9A-Fa-f:.]+$" },
    "host": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.:\\[\\]-]+$" },
    "power": {
      "description": "Transmit power in dBm, or auto.",
      "oneOf": [{ "const": "auto" }, { "type": "integer", "minimum": 1, "maximum": 30 }]
    },
    "radio2g": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "channel": { "oneOf": [{ "const": "auto" }, { "type": "integer", "minimum": 1, "maximum": 14 }] },
        "width": { "enum": [20, 40], "description": "MHz." },
        "power": { "$ref": "#/$defs/power" }
      }
    },
    "radio5g": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "channel": { "oneOf": [{ "const": "auto" }, { "enum": [36, 40, 44, 48, 52, 56, 60, 64, 100, 104, 108, 112, 116, 120, 124, 128, 132, 136, 140, 144, 149, 153, 157, 161, 165, 169, 173, 177] }] },
        "width": { "enum": [20, 40, 80, 160], "description": "MHz." },
        "power": { "$ref": "#/$defs/power" },
        "dfs": { "enum": ["allow", "avoid"], "default": "allow", "description": "avoid keeps an automatic channel off the DFS channels, 52–144, which are shared with radar; a channel or width that needs them is refused (0071). allow (the default) lets the AP pick any." }
      }
    },
    "radio6g": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "channel": { "oneOf": [{ "const": "auto" }, { "enum": [1, 5, 9, 13, 17, 21, 25, 29, 33, 37, 41, 45, 49, 53, 57, 61, 65, 69, 73, 77, 81, 85, 89, 93, 97, 101, 105, 109, 113, 117, 121, 125, 129, 133, 137, 141, 145, 149, 153, 157, 161, 165, 169, 173, 177, 181, 185, 189, 193, 197, 201, 205, 209, 213, 217, 221, 225, 229, 233] }] },
        "width": { "enum": [20, 40, 80, 160, 320], "description": "MHz." },
        "power": { "$ref": "#/$defs/power" }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true, "description": "false turns the port off (0053); unset, the AP leaves it as it is, which is on unless Aeolus turned it off." },
        "uplink": { "type": "boolean", "description": "The port that reaches the manager: the tunnel source (0018) and where VLANs are detected (0020)." },
        "mode": { "enum": ["trunk", "access", "tunnel", "lacp"], "description": "access carries one VLAN, untagged; trunk an untagged VLAN and tagged ones (0053); tunnel carries VNIs over tunnels instead, as vxlan maps them (0058). LACP is not applied yet." },
        "untagged": { "type": "integer", "minimum": 0, "maximum": 4094, "description": "0 means no untagged VLAN." },
        "tagged": { "type": "array", "items": { "$ref": "#/$defs/vlan" }, "uniqueItems": true, "description": "Only a trunk carries tagged VLANs." },
        "bond": { "$ref": "#/$defs/id", "description": "The LACP bond this port belongs to." },
        "vxlan": {
          "description": "In tunnel mode, the VNIs the port carries, by the VLAN each is tagged with on the wire, or untagged (0058).",
          "type": "object",
          "propertyNames": { "pattern": "^(untagged|[1-9][0-9]{0,3})$" },
          "additionalProperties": { "$ref": "#/$defs/portVNI" }
        }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "lacp" } }, "required": ["mode"] }, "then": { "required": ["bond"] } }
      ]
    },
    "portVNI": {
      "description": "One VNI a tunnel port carries (0058).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tunnel": { "$ref": "#/$defs/id", "description": "The tunnel it travels over, by name, as set in Locations (0055)." },
        "vni": { "type": "integer", "minimum": 1, "maximum": 16777215 },
        "probe": { "$ref": "#/$defs/probeAddress" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true, "description": "false turns off an inherited network in one place (0012); unset, it is on." },
        "ssid": { "type": "string", "minLength": 1, "maxLength": 32 },
        "hidden": { "type": "boolean" },
        "bands": { "type": "array", "items": { "enum": ["2g", "5g", "6g"] }, "minItems": 1, "uniqueItems": true },
        "security": { "enum": ["open", "owe", "wpa2-psk", "wpa3-sae", "wpa2-wpa3"] },
        "passphrase": { "type": "string", "minLength": 8, "maxLength": 63, "writeOnly": true },
        "isolation": { "type": "boolean", "description": "Client isolation." },
        "multicast_to_unicast": { "type": "boolean", "description": "Send all multicast (ARP, IPv4, IPv6) to each client as unicast (0049). Unset: OpenWrt's default, which does so only for groups clients joined (IGMP/MLD snooping)." },
        "band_steering": { "type": "boolean", "description": "Steer clients that can use a higher band onto it, through usteer, which the agent's installer adds (0050). Turns on 802.11k and 802.11v for this network, which steering uses." },
        "roaming": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ft": { "type": "boolean", "description": "802.11r." },
            "rrm": { "type": "boolean", "description": "802.11k." },
            "btm": { "type": "boolean", "description": "802.11v." }
          }
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per-user keys (0070).",
          "properties": {
            "vlans": { "type": "array", "items": { "$ref": "#/$defs/vlan" }, "uniqueItems": true, "maxItems": 512, "description": "The VLANs a per-user key may put its client in." }
          }
        },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "down_kbps": { "type": "integer", "minimum": 0, "description": "0 means no limit." },
            "up_kbps": { "type": "integer", "minimum": 0, "description": "0 means no limit." }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": { "$ref": "#/$defs/transport" },
            "fallback": { "$ref": "#/$defs/transport" },
            "switching": { "enum": ["report", "automatic"], "default": "report", "description": "report (the default) probes both transports and never moves the network; automatic moves it to the fallback while the primary is down (0061)." },
            "ha": { "type": "boolean", "description": "With automatic switching: keep a VXLAN fallback started and probed, so a switch is a re-attach; unset, it is started when the primary goes down (0022, 0061)." },
            "failback": { "enum": ["revertive", "equal"], "default": "revertive", "description": "With automatic switching: revertive moves back to the primary after the hold-down; equal stays on the fallback until it fails (0022, 0061)." },
            "holddown": { "type": "integer", "minimum": 0, "maximum": 3600, "default": 300, "description": "Seconds the primary must answer before a revertive switch back (0061)." }
          },
          "required": ["primary"]
        }
      },
      "required": ["ssid", "security", "transport"],
      "allOf": [
        { "if": { "properties": { "security": { "enum": ["wpa2-psk", "wpa3-sae", "wpa2-wpa3"] } }, "required": ["security"] }, "then": { "required": ["passphrase"] } }
      ]
    },
    "transport": {
      "description": "How a network's traffic gets where it is going (0018).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["vlan", "vxlan"] },
        "vlan": { "$ref": "#/$defs/vlan" },
        "concentrator": { "$ref": "#/$defs/id", "description": "The tunnel it travels over, by name, as set in Locations (0055)." },
        "vni": { "type": "integer", "minimum": 1, "maximum": 16777215 },
        "probe": { "$ref": "#/$defs/probeAddress" }
      },
      "required": ["type"],
      "allOf": [
        { "if": { "properties": { "type": { "const": "vlan" } }, "required": ["type"] }, "then": { "required": ["vlan"] } },
        { "if": { "properties": { "type": { "const": "vxlan" } }, "required": ["type"] }, "then": { "required": ["concentrator", "vni"] } }
      ]
    },
    "concentrator": {
      "description": "A tunnel: the IP address of its far end, its UDP port and the MTU (0018, 0055).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/ipAddress" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "mtu": { "type": "integer", "minimum": 1280, "maximum": 9000, "description": "The largest frame the tunnel carries. Unset, it is the default: 1450 over IPv4 and 1430 over IPv6, which a 1500-byte path carries (0056). Larger needs the AP's uplink to carry it plus 50 bytes, or 70 over IPv6." },
        "probe_interval": { "type": "integer", "minimum": 5, "maximum": 300, "default": 30, "description": "Seconds between the AP's probes of each VNI on the tunnel, which keep it open at the concentrator and show whether it works (0059); three missed in a row and it is down." },
        "underlay_vlan": { "type": "integer", "minimum": 0, "maximum": 4094, "description": "Where the tunnel starts on the AP (0063): 0, or unset, for the management VLAN; otherwise a VLAN on the AP's uplink, where the AP takes an address by DHCP for its tunnels." }
      },
      "required": ["address", "port"]
    },
    "libraryConcentrator": {
      "description": "A concentrator as the Org's library holds it (0023). Not part of an AP's config.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "address": { "$ref": "#/$defs/host" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "mtu": { "type": "integer", "minimum": 1280, "maximum": 9000 },
        "vnis": {
          "description": "VNIs on this concentrator, keyed by VNI number, each with a label.",
          "type": "object",
          "propertyNames": { "pattern": "^[1-9][0-9]{0,7}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "required": ["label"]
          }
        },
        "scope": {
          "description": "Location folders where this concentrator can be used; empty means everywhere.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "required": ["name", "address", "port", "mtu"]
    }
  }
}
